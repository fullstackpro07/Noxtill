  requested
  booked
  confirmed
  completed
  no_show
  cancelled
}

enum AppointmentSource {
  link
  qr
  walk_in
  /// Created by accepting a Waiting List offer (UPD-BE-017).
  waitlist
  /// Booked live during an AI Phone Receptionist call (UPD-BE-058).
  phone
