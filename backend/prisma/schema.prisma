enum WaitlistStatus {
  waiting
  offered
  booked
  expired
  cancelled
}

enum QueueTokenStatus {
  waiting
  called
  serving
  served
  skipped
  cancelled
}

enum DepositStatus {
  pending
  captured
  refunded
  forfeited
}

/// Deposit settings (UPD-BE-091) — the trigger rule's amount shape.
enum DepositAmountType {
  flat
  percent
}

enum MessageChannel {
  whatsapp
  sms
  email
}

enum MessageCategory {
  utility
  marketing
}

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
}

enum ReviewRoute {
  public
  private
}

enum FeedbackStatus {
  open
  assigned
  resolved
}

enum VideoTestimonialStatus {
  requested
  submitted
  approved
  rejected
}

enum StockMovementKind {
  purchase
  sale
  wastage
  adjustment
  return
  transfer_out
  transfer_in
}

enum StockTransferStatus {
  pending
  approved
  shipped
  received
  rejected
  cancelled
}

enum ImportSource {
  csv
  xlsx
  text
  docx
  /// AI Photo Digitizer (UPD-BE-060) — a scanned photo, extracted via Claude Vision.
  photo
}

enum ImportStatus {
  pending
  processing
  completed
  failed
}

enum IntegrationProvider {
  email
  gmb
  google_ads
  merchant
  meta_ads
  tiktok_ads
  bing_places
  apple_business_connect
  yelp
  /// UPD-BE-069 unified Advertising — extends the ad-platform set beyond the original 3.
  linkedin_ads
  pinterest_ads
  snapchat_ads
  microsoft_ads
  amazon_ads
  reddit_ads
  /// UPD-BE-072 Accounting Sync.
  quickbooks
  xero
  /// UPD-BE-073 E-commerce Sync.
  shopify
  woocommerce
  /// UPD-BE-074 Automation Platforms — not registered in `ConnectorRegistry` (no OAuth flow;
  /// connection is a REST-Hook-style webhook subscription instead, see `OutboundWebhook`).
  zapier
  make
  n8n
