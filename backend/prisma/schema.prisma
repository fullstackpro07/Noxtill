  developer
}

enum GmbPostStatus {
  draft
  published
  failed
}

/// Social Media Management (UPD-BE-M15) — the 15 platforms this milestone covers. 11 are real
/// OAuth2 (facebook, instagram, twitter, linkedin, tiktok, youtube, pinterest, snapchat, threads,
/// reddit, tumblr); 4 are token/bot-credential based, no user-facing OAuth flow (telegram,
/// discord, wechat, line) — same real-vs-non-OAuth split as UPD-BE-041's directory connectors.
enum SocialPlatform {
  facebook
  instagram
  twitter
  linkedin
  tiktok
  youtube
  pinterest
  snapchat
  threads
  reddit
  tumblr
  telegram
  discord
  wechat
  line
}

enum SocialAccountStatus {
  not_connected
  connected
  needs_attention
}

enum SocialPostStatus {
  draft
  scheduled
  publishing
  published
  partially_failed
  failed
}

enum SocialPostTargetStatus {
  pending
  published
  failed
}

enum SocialInboxKind {
  comment
  dm
}

enum SocialInboxStatus {
  unread
  read
  replied
}

enum IntegrationStatus {
  not_connected
  connected
  needs_attention
}

enum EmailEventType {
  sent
  delivered
  open
  click
  unsub
}

enum LoyaltyProgramType {
  punch_card
  tier
}

enum MembershipStatus {
  pending
  active
  cancelled
  expired
}

enum BillingInterval {
  monthly
  yearly
}

// ─────────────────────────────────────────────────────────────────────────
// BE-001 — Identity & tenancy
// ─────────────────────────────────────────────────────────────────────────

model BusinessCategory {
  id              String         @id @default(uuid())
  key             String         @unique
  name            String
  defaultTemplate Json           @default("{}") @map("default_template")
  businessTypes   BusinessType[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_categories")
}

model BusinessType {
  id              String           @id @default(uuid())
  categoryId      String           @map("category_id")
  category        BusinessCategory @relation(fields: [categoryId], references: [id])
  key             String           @unique
  label           String
  labelOverrides  Json             @default("{}") @map("label_overrides")
  widgetOverrides Json             @default("{}") @map("widget_overrides")
  aiGenerated     Boolean          @default(false) @map("ai_generated")
  businesses      Business[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("business_types")
}

model Widget {
  id           String @id @default(uuid())
  key          String @unique
  name         String
  module       String
  dataEndpoint String @map("data_endpoint")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("widgets")
}

model Plan {
  id            String     @id @default(uuid())
  key           String     @unique
  name          String
  price         Decimal    @db.Decimal(10, 2)
  msgQuota      Int        @map("msg_quota")
  userLimit     Int        @map("user_limit")
  features      Json       @default("{}")
  stripePriceId String?    @unique @map("stripe_price_id")
  businesses    Business[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model Business {
  id     String        @id @default(uuid())
  name   String
  slug   String        @unique
  typeId String?       @map("type_id")
  type   BusinessType? @relation(fields: [typeId], references: [id])
  planId String?       @map("plan_id")
  plan   Plan?         @relation(fields: [planId], references: [id])

  currency    String         @default("USD")
  timezone    String         @default("UTC")
  locale      String         @default("en")
  country     String?
  channelPref MessageChannel @default(whatsapp) @map("channel_pref")

  nightlyCloseTime String  @default("22:00") @map("nightly_close_time")
  taxLabel         String  @default("Tax") @map("tax_label")
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)

  msgQuota Int @default(600) @map("msg_quota")
  msgUsed  Int @default(0) @map("msg_used")

  branding        Json    @default("{}")
  dashboardConfig Json    @default("{}") @map("dashboard_config")
  publicReviewUrl String? @map("public_review_url")

  /// Weekly hours, e.g. `{"mon":[["09:00","17:00"]],"tue":[...] , ... }`; a missing/empty day is closed.
  workingHours Json @default("{}") @map("working_hours")

  /// Referral reward config (BE-062), e.g. `{"enabled":true,"rewardType":"credit","rewardValue":10}`.
  referralSettings Json @default("{}") @map("referral_settings")

  /// Business Health Score component weighting (UPD-BE-001), each 0-100 summing to 100, e.g.
  /// `{"ratingTrend":25,"repeatCustomerRate":25,"margin":25,"creditRecovery":25}`. Empty until set.
  healthScoreWeights Json @default("{}") @map("health_score_weights")

  /// AI usage guardrails (BE-075): shared across every AI feature (what-if, branch-advisor,
  /// review AI-draft, business-type mapping, RAG help, assistant chat).
  aiMonthlyCostCapUsd  Decimal @default(5.00) @map("ai_monthly_cost_cap_usd") @db.Decimal(8, 2)
  aiRateLimitPerMinute Int     @default(10) @map("ai_rate_limit_per_minute")

  /// Timesheets (UPD-BE-032): weekly hours beyond this count as overtime for that week.
  overtimeThresholdHoursPerWeek Int @default(40) @map("overtime_threshold_hours_per_week")

  parentId String?    @map("parent_id")
  parent   Business?  @relation("BusinessBranches", fields: [parentId], references: [id])
  branches Business[] @relation("BusinessBranches")

  trialEndsAt DateTime? @map("trial_ends_at")

  /// Billing (BE-064/065): Stripe customer/subscription linkage, set once checkout completes.
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  /// Last time msgUsed was reset to 0 for a new billing month (INT-014) — null until the first reset.
  msgQuotaResetAt      DateTime? @map("msg_quota_reset_at")

  businessUsers            BusinessUser[]
  customers                Customer[]
  products                 Product[]
  orders                   Order[]
  creditEntries            CreditEntry[]
  appointments             Appointment[]
  messages                 Message[]
  whatsappWindows          WhatsappWindow[]
  reviewRequests           ReviewRequest[]
  privateFeedback          PrivateFeedback[]
  externalReviews          ExternalReview[]
  stockMovements           StockMovement[]
  expenses                 Expense[]
  attendance               Attendance[]
  campaigns                Campaign[]
  competitors              Competitor[]
  trackedKeywords          TrackedKeyword[]
  auditLogs                AuditLog[]
  importBatches            ImportBatch[]
  integrations             Integration[]
  adCampaigns              AdCampaign[]
  emailCampaigns           EmailCampaign[]
  productFeedItems         ProductFeedItem[]
  gmbPosts                 GmbPost[]
  notifications            Notification[]
  healthScoreSnapshots     HealthScoreSnapshot[]
  activityEvents           ActivityEvent[]
  aiInsights               AiInsight[]
  actionItemStates         ActionItemState[]
  heldSales                HeldSale[]
  cashShifts               CashShift[]
  cashMovements            CashMovement[]
  voiceSaleDrafts          VoiceSaleDraft[]
  tables                   Table[]
  returns                  Return[]
  receiptLogs              ReceiptLog[]
  variantSets              VariantSet[]
  bundles                  Bundle[]
  suppliers                Supplier[]
  priceHistory             PriceHistory[]
  categories               Category[]
  scheduledExports         ScheduledExport[]
  waitlistEntries          WaitlistEntry[]
  queueTokens              QueueToken[]
  deposits                 Deposit[]
  depositSettings          DepositSettings?
  bookingLinkSettings      BookingLinkSettings?
  bookingLinkVisits        BookingLinkVisit[]
  reminderRules            ReminderRule[]
  installmentPlans         InstallmentPlan[]
  installments             Installment[]
  creditShareLinks         CreditShareLink[]
  creditReminderRules      CreditReminderRule[]
  creditReminderLogs       CreditReminderLog[]
  segments                 Segment[]
  loyaltyPrograms          LoyaltyProgram[]
  loyaltyMembers           LoyaltyMember[]
  membershipPlans          MembershipPlan[]
  memberships              Membership[]
  memoryNotes              MemoryNote[]
  videoTestimonials        VideoTestimonial[]
  coupons                  Coupon[]
  vouchers                 Voucher[]
  workflows                Workflow[]
  workflowRuns             WorkflowRun[]
  staffShifts              StaffShift[]
  timeOff                  TimeOff[]
  timesheetApprovals       TimesheetApproval[]
  staffAdvances            StaffAdvance[]
  stockTransfersOut        StockTransfer[]           @relation("StockTransferSource")
  stockTransfersIn         StockTransfer[]           @relation("StockTransferDest")
  stockCounts              StockCount[]
  customRoles              CustomRole[]
  labelOverrides           LabelOverride[]
  optionSets               OptionSet[]
  sessions                 Session[]
  masterListing            MasterListing?
  listingSyncLogs          ListingSyncLog[]
  citations                Citation[]
  gmbPhotos                GmbPhoto[]
  gmbQnas                  GmbQna[]
  gmbInsightsSnapshots     GmbInsightsSnapshot[]
  socialAccounts           SocialAccount[]
  mediaAssets              MediaAsset[]
  socialPosts              SocialPost[]
  socialInboxItems         SocialInboxItem[]
  socialAnalyticsSnapshots SocialAnalyticsSnapshot[]
  socialSettings           SocialSettings?
  visibilityScoreSnapshots VisibilityScoreSnapshot[]
  competitiveOpportunities CompetitiveOpportunity[]
  competitiveSettings      CompetitiveSettings?
  phoneNumber              PhoneNumber?
  phoneCalls               PhoneCall[]
  digitizerAliases         DigitizerAlias[]
  riders                   Rider[]
  deliveries               Delivery[]
  routes                   Route[]
  deliveryZones            DeliveryZone[]
  adCreatives              AdCreative[]
  adAudiences              AdAudience[]
  adLeads                  AdLead[]
  accountingMappings       AccountingMapping[]
  outboundWebhooks         OutboundWebhook[]
  reviewSentimentThemes    ReviewSentimentTheme[]
  recurringObligations     RecurringObligation[]
  seoHeatmapPoints         SeoHeatmapPoint[]
  apiKeys                  ApiKey[]
  nightlyCloseLogs         NightlyCloseLog[]
  healthScoreWeightChanges HealthScoreWeightChange[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("businesses")
}

model User {
  id                  String    @id @default(uuid())
  email               String?   @unique
  phone               String?   @unique
  passwordHash        String    @map("password_hash")
  name                String
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  /// UPD-BE-040: WhatsApp-OTP two-factor. Replaces the old single `refreshTokenHash` column —
  /// each login now creates its own `Session` row instead of overwriting one shared hash, which
  /// also fixes the pre-existing "logging in on a second device silently kills the first" bug.
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")

  businessUsers  BusinessUser[]
  notifications  Notification[]
  sessions       Session[]
  twoFactorCodes TwoFactorCode[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// UPD-BE-040. One row per real login — replaces the single `User.refreshTokenHash` column so a
/// user can hold multiple concurrent sessions (one per device) and revoke them individually.
/// `businessId` is carried directly since a session is scoped to the one business the JWT was
/// issued for, same as the JWT payload itself.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  businessId       String    @map("business_id")
  business         Business  @relation(fields: [businessId], references: [id])
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([businessId])
  @@map("sessions")
}

/// UPD-BE-040. A short-lived, single-use WhatsApp-delivered code — used both to confirm 2FA
/// enrollment and to complete a 2FA-gated login. Never stores the raw code, only its hash.
model TwoFactorCode {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("two_factor_codes")
}

model BusinessUser {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  business       Business @relation(fields: [businessId], references: [id])
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  role           Role     @default(staff)
  commissionRule Json     @default("{}") @map("commission_rule")

  attendance         Attendance[]
  appointments       Appointment[]       @relation("StaffAppointments")
  orders             Order[]
  waitlistEntries    WaitlistEntry[]
  staffShifts        StaffShift[]
  timeOff            TimeOff[]
  timesheetApprovals TimesheetApproval[]
  staffAdvances      StaffAdvance[]

  /// Roles & Permissions matrix (UPD-BE-035). Null (the default for every existing/new
  /// BusinessUser) means "use `role`'s fixed system capability set" — set only for a user
  /// deliberately assigned a business-defined custom role instead.
  customRoleId String?     @map("custom_role_id")
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, userId])
  @@index([businessId])
  @@map("business_users")
}

/// User-facing notification inbox (INT-012) — distinct from `Event` (BE-072), which is a
/// write-only, non-tenant analytics sink read only by platform-admin endpoints. Scoped to a
/// single recipient user, not the whole business, so e.g. one owner's export doesn't show up
/// in another staff member's bell.
model Notification {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  title      String
  body       String   @db.Text
  link       String?
  read       Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, userId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// BE-002 — Commerce
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id               String    @id @default(uuid())
  businessId       String    @map("business_id")
  business         Business  @relation(fields: [businessId], references: [id])
  phone            String
  name             String
  email            String?
  address          String?
  birthday         DateTime? @db.Date
  notes            String?   @db.Text
  /// MySQL migration: was a native `String[]` array (Postgres-only) — Prisma's MySQL connector has
  /// no scalar-list column type, so this is a JSON array instead. Read/written wholesale in JS
  /// (see `customers.service.ts`), not via Prisma's array `push`/`has` operators anymore.
  tags             Json      @default("[]")
  consentMarketing Boolean   @default(true) @map("consent_marketing")
  optedOut         Boolean   @default(false) @map("opted_out")
  lifetimeSpend    Decimal   @default(0) @map("lifetime_spend") @db.Decimal(12, 2)
  visitCount       Int       @default(0) @map("visit_count")
  lastVisitAt      DateTime? @map("last_visit_at")

  /// Referrals (BE-062): the existing customer whose code brought this customer in, if any.
  referredByCustomerId String?    @map("referred_by_customer_id")
  referredBy           Customer?  @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id])
  referrals            Customer[] @relation("CustomerReferrals")
  /// Set once this customer's first order triggers a reward to their referrer — prevents double-issuance.
  referralRewardedAt   DateTime?  @map("referral_rewarded_at")

  orders            Order[]
  creditEntries     CreditEntry[]
  appointments      Appointment[]
  messages          Message[]
  whatsappWindows   WhatsappWindow[]
  reviewRequests    ReviewRequest[]
  privateFeedback   PrivateFeedback[]
  returns           Return[]
  waitlistEntries   WaitlistEntry[]
  queueTokens       QueueToken[]
  installmentPlans  InstallmentPlan[]
  creditShareLinks  CreditShareLink[]
  creditReminderLogs CreditReminderLog[]
  loyaltyMembers    LoyaltyMember[]
  memberships       Membership[]
  videoTestimonials VideoTestimonial[]
  vouchers          Voucher[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, phone])
  @@index([businessId, name])
  @@fulltext([name])
  @@map("customers")
}

/// Segments, real rule builder (UPD-BE-098) — replaces the compute-on-the-fly vip/new/lapsed
/// hardcoding with persisted, arbitrary-field AND/OR rules. Coexists with (doesn't replace) the
/// legacy `GET /segments/:key` hardcoded lookup that `CampaignsService` already depends on —
/// `SegmentsService.getSegment` tries a real `Segment.id` first, then falls back to the old keys,
/// so campaigns can target either kind of segment through the same one code path.
model Segment {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  /// `{ combinator: 'AND' | 'OR', conditions: [{ field, operator, value }] }` — see `segment-rules.util.ts`.
  rules      Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("segments")
}

/// Loyalty punch cards/tiers (UPD-BE-024). One business can run multiple programs (e.g. a punch
/// card AND a spend-tier program at once); a customer can be a member of more than one.
/// `stampsRequired`/`rewardDescription` only matter for `type: punch_card`; `tiers` (an ordered
/// `[{name, minSpend}]` array) only matters for `type: tier` — tier is computed at read time
/// from the customer's real `Customer.lifetimeSpend`, never stored/duplicated.
model LoyaltyProgram {
  id                String             @id @default(uuid())
  businessId        String             @map("business_id")
  business          Business           @relation(fields: [businessId], references: [id])
  name              String
  type              LoyaltyProgramType @default(punch_card)
  stampsRequired    Int                @default(10) @map("stamps_required")
  rewardDescription String?            @map("reward_description")
  /// Tier thresholds for `type: tier`, e.g. `[{"name":"Silver","minSpend":100},{"name":"Gold","minSpend":500}]`.
  tiers             Json               @default("[]")
  active            Boolean            @default(true)

  members LoyaltyMember[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("loyalty_programs")
}

model LoyaltyMember {
  id            String         @id @default(uuid())
  businessId    String         @map("business_id")
  business      Business       @relation(fields: [businessId], references: [id])
  programId     String         @map("program_id")
  program       LoyaltyProgram @relation(fields: [programId], references: [id])
  customerId    String         @map("customer_id")
  customer      Customer       @relation(fields: [customerId], references: [id])
  /// Denormalized cache of `stamps.count(redeemed: false)` — kept in sync at issue/redeem time.
  stampCount    Int            @default(0) @map("stamp_count")
  redeemedCount Int            @default(0) @map("redeemed_count")

  stamps Stamp[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([programId, customerId])
  @@index([businessId, customerId])
  @@map("loyalty_members")
}

/// One row per stamp actually issued — an audit trail of which sale (if any) earned it, not just a counter.
model Stamp {
  id       String        @id @default(uuid())
  memberId String        @map("member_id")
  member   LoyaltyMember @relation(fields: [memberId], references: [id])
  orderId  String?       @map("order_id")
  order    Order?        @relation(fields: [orderId], references: [id])
  redeemed Boolean       @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([memberId])
  @@map("stamps")
}

/// Membership plans (UPD-BE-025) — a customer-level recurring subscription, deliberately kept
/// separate from the business's OWN Stripe billing plan (`Business.stripeSubscriptionId`/
/// `stripe-webhook.controller.ts`). Online checkout uses a distinct `membershipId`-keyed Stripe
/// metadata field (see `PaymentGatewayAdapter.createSubscriptionCheckout`) so it can never collide
/// with — or corrupt — the business-plan webhook path, which is keyed on `businessId`.
model MembershipPlan {
  id            String          @id @default(uuid())
  businessId    String          @map("business_id")
  business      Business        @relation(fields: [businessId], references: [id])
  name          String
  price         Decimal         @db.Decimal(12, 2)
  interval      BillingInterval @default(monthly)
  benefits      String?
  /// Set to enable real online (Stripe) checkout for this plan; without it, only `method: cash` enrollment works.
  stripePriceId String?         @map("stripe_price_id")
  active        Boolean         @default(true)

  memberships Membership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("membership_plans")
}

/// Status sync for online (Stripe) memberships is manual today (`POST /memberships/:id/activate`) —
/// a disclosed gap, not a full webhook pipeline, to avoid touching the business-plan webhook path.
/// Cash memberships go straight to `active` since no gateway is involved.
model Membership {
  id                   String           @id @default(uuid())
  businessId           String           @map("business_id")
  business             Business         @relation(fields: [businessId], references: [id])
  planId               String           @map("plan_id")
  plan                 MembershipPlan   @relation(fields: [planId], references: [id])
  customerId           String           @map("customer_id")
  customer             Customer         @relation(fields: [customerId], references: [id])
  status               MembershipStatus @default(pending)
  method               PaymentMethod    @default(cash)
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime?        @map("current_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, customerId])
  @@map("memberships")
}

/// Business Memory notes (UPD-BE-026) — polymorphic, multi-row, timestamped notes, distinct from
/// the existing single-scalar `Customer.notes`/`Supplier.notes` fields. `subjectType`/`subjectId`
/// follow the same non-FK opaque-string convention as `ActivityEvent.entityType`/`entityId` and
/// `AuditLog.entity`/`entityId` — `subjectType` is one of `customer|supplier|product|table`,
/// validated against the real row at write time in the service layer, not by a DB constraint.
model MemoryNote {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id])
  subjectType  String   @map("subject_type")
  subjectId    String   @map("subject_id")
  body         String   @db.Text
  pinned       Boolean  @default(false)
  authorUserId String?  @map("author_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, subjectType, subjectId])
  @@map("memory_notes")
}

model Product {
  id                String      @id @default(uuid())
  businessId        String      @map("business_id")
  business          Business    @relation(fields: [businessId], references: [id])
  kind              ProductKind @default(product)
  name              String
  category          String?
  sku               String?
  variations        Json        @default("[]")
  costPrice         Decimal     @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice      Decimal     @default(0) @map("selling_price") @db.Decimal(12, 2)
  stockQty          Int         @default(0) @map("stock_qty")
  lowStockThreshold Int         @default(5) @map("low_stock_threshold")
  durationMin       Int?        @map("duration_min")
  active            Boolean     @default(true)

  /// Category, formalized (UPD-BE-088) — the real, canonical category once set; `category` (the
  /// free-text field above) stays as-is for backward compatibility with every existing reader, but
  /// new code should prefer this relation.
  categoryId  String?   @map("category_id")
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  /// Services, formal fields (UPD-BE-087) — staff/buffer/deposit config the spec expects to live on
  /// the service itself, not re-entered per appointment. `eligibleStaffIds` is a JSON array of
  /// `BusinessUser.id`s (MySQL has no native array column) — an empty array means "any staff
  /// eligible," matching every service that predates this feature.
  eligibleStaffIds Json     @default("[]") @map("eligible_staff_ids")
  bufferBeforeMin  Int?     @map("buffer_before_min")
  bufferAfterMin   Int?     @map("buffer_after_min")
  depositRequired  Boolean  @default(false) @map("deposit_required")
  depositAmount    Decimal? @map("deposit_amount") @db.Decimal(12, 2)

  orderItems         OrderItem[]
  stockMovements     StockMovement[]
  appointments       Appointment[]
  productFeedItems   ProductFeedItem[]
  /// Set only when this product is the sellable, catalog-facing "face" of a bundle (UPD-BE-013).
  bundle             Bundle?
  bundleItems        BundleItem[]
  priceHistory       PriceHistory[]
  waitlistEntries    WaitlistEntry[]
  queueTokens        QueueToken[]
  stockTransferItems StockTransferItem[]
  stockCountLines    StockCountLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, sku])
  @@index([businessId])
  @@fulltext([name])
  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  businessId  String      @map("business_id")
  business    Business    @relation(fields: [businessId], references: [id])
  orderNo     Int         @map("order_no")
  customerId  String?     @map("customer_id")
  customer    Customer?   @relation(fields: [customerId], references: [id])
  orderType   OrderType   @default(counter) @map("order_type")
  tableNo     String?     @map("table_no")
  status      OrderStatus @default(pending)
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  cogs        Decimal     @default(0) @db.Decimal(12, 2)
  isQuotation Boolean     @default(false) @map("is_quotation")

  /// Staff member who rang up the sale, if any — drives commission attribution (BE-058).
  staffUserId String?       @map("staff_user_id")
  staffUser   BusinessUser? @relation(fields: [staffUserId], references: [id])

  /// Coupons (UPD-BE-029): set when a coupon code was applied at sale time. The discount amount
  /// it contributed is broken out separately so `discount`/`total` stay the single source of
  /// truth for accounting while this stays attributable/auditable.
  couponId             String?  @map("coupon_id")
  coupon               Coupon?  @relation(fields: [couponId], references: [id])
  couponDiscountAmount Decimal? @map("coupon_discount_amount") @db.Decimal(10, 2)

  /// Vouchers (UPD-BE-030): a voucher is a payment method, not a discount — it reduces the amount
  /// collected via `payment`/`creditEntry`, never `total` itself.
  voucherId            String?  @map("voucher_id")
  voucher              Voucher? @relation(fields: [voucherId], references: [id])
  voucherAmountApplied Decimal? @map("voucher_amount_applied") @db.Decimal(10, 2)

  /// E-commerce Sync (UPD-BE-073): set only for an order pulled in from a connected e-commerce
  /// platform — a real order this business's POS never rang up directly. NULL for every ordinary
  /// POS/booking/online order, which is why MySQL allowing multiple NULLs in a unique index is
  /// exactly what this constraint needs (only e-commerce-sourced orders are deduplicated by it).
  externalId       String?              @map("external_id")
  externalProvider IntegrationProvider? @map("external_provider")

  /// Accounting Sync (UPD-BE-072): set once this order has been pushed as a real invoice to the
  /// business's connected accounting provider — the guard against re-pushing the same order.
  accountingSyncedAt   DateTime? @map("accounting_synced_at")
  accountingExternalId String?   @map("accounting_external_id")

  items         OrderItem[]
  payments      Payment[]
  creditEntries CreditEntry[]
  returns       Return[]
  receiptLogs   ReceiptLog[]
  stamps        Stamp[]
  delivery      Delivery?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, orderNo])
  @@unique([businessId, externalProvider, externalId])
  @@index([businessId, status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Decimal  @db.Decimal(12, 2)
  cost      Decimal  @db.Decimal(12, 2)
  qty       Int

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  order       Order         @relation(fields: [orderId], references: [id])
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  providerRef String?       @map("provider_ref")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

/// Tables / restaurant floor mode (UPD-BE-010). Deliberately NOT a foreign key on `Order.tableNo`
/// (which stays free text, matching every existing order-creation path) — a table's live status
/// and running total are computed by joining on `Order.tableNo = Table.number` at read time, the
/// same join the frontend's pre-existing `tables-grid.tsx` already does client-side today.
model Table {
  id         String      @id @default(uuid())
  businessId String      @map("business_id")
  business   Business    @relation(fields: [businessId], references: [id])
  number     String
  floor      String?
  posX       Int?        @map("pos_x")
  posY       Int?        @map("pos_y")
  seats      Int?
  status     TableStatus @default(free)
  seatedAt   DateTime?   @map("seated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, number])
  @@map("tables")
}

/// Returns & Refunds (UPD-BE-011). A return is raised (any role) then approved/rejected
/// (owner/manager only, per the plan's own architecture rule). Approval is the one moment real
/// stock and money move — everything before that is just a proposal.
model Return {
  id                String             @id @default(uuid())
  businessId        String             @map("business_id")
  business          Business           @relation(fields: [businessId], references: [id])
  orderId           String             @map("order_id")
  order             Order              @relation(fields: [orderId], references: [id])
  customerId        String?            @map("customer_id")
  customer          Customer?          @relation(fields: [customerId], references: [id])
  reason            String
  refundMethod      ReturnRefundMethod @map("refund_method")
  refundAmount      Decimal            @map("refund_amount") @db.Decimal(12, 2)
  status            ReturnStatus       @default(pending)
  restock           Boolean            @default(true)
  requestedByUserId String?            @map("requested_by_user_id")
  approvedByUserId  String?            @map("approved_by_user_id")

  items ReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@map("returns")
}

model ReturnItem {
  id        String  @id @default(uuid())
  returnId  String  @map("return_id")
  return    Return  @relation(fields: [returnId], references: [id])
  productId String  @map("product_id")
  qty       Int
  amount    Decimal @db.Decimal(12, 2)

  @@index([returnId])
  @@map("return_items")
}

enum ReceiptChannel {
  digital
  print
}

/// Receipts, dedicated resend (UPD-BE-086). One row per real send/print action — lets the
/// Receipts screen show a genuine digital-vs-printed delivery split instead of a guess, and gives
/// each order a real history of who resent its receipt and how.
model ReceiptLog {
  id           String         @id @default(uuid())
  businessId   String         @map("business_id")
  business     Business       @relation(fields: [businessId], references: [id])
  orderId      String         @map("order_id")
  order        Order          @relation(fields: [orderId], references: [id])
  channel      ReceiptChannel
  sentByUserId String?        @map("sent_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, orderId])
  @@index([businessId, createdAt])
  @@map("receipt_log")
}

/// Held Sales (UPD-BE-005) — a cart snapshot taken before checkout (no payment chosen yet).
/// Resuming feeds `cart` straight into the real `OrdersService.createSale()` unchanged, so the
/// exact same atomic validation (stock, pricing, credit-requires-customer) applies at resume time
/// as at any normal sale — a held sale is never itself a special, less-validated path.
model HeldSale {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id])
  /// The held cart: every `CreateSaleDto` field except `payment`, which isn't chosen until resume.
  cart         Json
  heldByUserId String?  @map("held_by_user_id")
  note         String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("held_sales")
}

/// Cash Register (UPD-BE-006). At most one open shift per business at a time, enforced in the
/// service layer (no partial unique index for "one open row" in Postgres without a filtered
/// index, which Prisma doesn't model directly — checked explicitly before opening a new shift).
model CashShift {
  id             String          @id @default(uuid())
  businessId     String          @map("business_id")
  business       Business        @relation(fields: [businessId], references: [id])
  openedByUserId String?         @map("opened_by_user_id")
  openingFloat   Decimal         @map("opening_float") @db.Decimal(12, 2)
  status         CashShiftStatus @default(open)

  /// Set only by a real reconciliation (UPD-BE-007) — a bare close via `POST /cash/shift/close`
  /// leaves these null, since no physical count was taken.
  countedCash  Decimal? @map("counted_cash") @db.Decimal(12, 2)
  variance     Decimal? @db.Decimal(12, 2)
  varianceNote String?  @map("variance_note")

  movements CashMovement[]

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  @@index([businessId, status])
  @@map("cash_shifts")
}

model CashMovement {
  id               String           @id @default(uuid())
  businessId       String           @map("business_id")
  business         Business         @relation(fields: [businessId], references: [id])
  shiftId          String           @map("shift_id")
  shift            CashShift        @relation(fields: [shiftId], references: [id])
  type             CashMovementType
  amount           Decimal          @db.Decimal(12, 2)
  note             String?
  recordedByUserId String?          @map("recorded_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, shiftId])
  @@map("cash_movements")
}

/// Voice-entry Sale (UPD-BE-008) — the AI's parsed guess is staged here, never written as a real
/// sale until an explicit `POST /voice/sales/:id/confirm` with the user's final (possibly
/// corrected) line items. Mirrors HeldSale's "never bypass createSale's own validation" discipline.
model VoiceSaleDraft {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  transcript String
  /// Best-effort parsed `{items:[{productId,name,qty,matched}], customerName?, paymentMethod?}` —
  /// `matched:false` items had no confident product-name match and need manual correction.
  parsedCart Json

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("voice_sale_drafts")
}

model CreditEntry {
  id         String          @id @default(uuid())
  businessId String          @map("business_id")
  business   Business        @relation(fields: [businessId], references: [id])
  customerId String          @map("customer_id")
  customer   Customer        @relation(fields: [customerId], references: [id])
  kind       CreditEntryKind
  amount     Decimal         @db.Decimal(12, 2)
  method     PaymentMethod?
  note       String?
  orderId    String?         @map("order_id")
  order      Order?          @relation(fields: [orderId], references: [id])

  /// Set when this entry is the payment record for a specific Installment (UPD-BE-021).
  installment Installment?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, customerId])
  @@map("credit_entries")
}

/// Instalment plans (UPD-BE-021) — schedules payment of an existing credit balance into fixed
/// amounts/dates. Deliberately does NOT itself create new debt (no `CreditEntry` is written when a
/// plan is created) — it only schedules how an already-owed balance gets paid down; each
/// installment becomes a real `CreditEntry` (kind `payment`) only once actually paid.
model InstallmentPlan {
  id          String                @id @default(uuid())
  businessId  String                @map("business_id")
  business    Business              @relation(fields: [businessId], references: [id])
  customerId  String                @map("customer_id")
  customer    Customer              @relation(fields: [customerId], references: [id])
  totalAmount Decimal               @map("total_amount") @db.Decimal(12, 2)
  status      InstallmentPlanStatus @default(active)
  note        String?

  installments Installment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, customerId])
  @@map("installment_plans")
}

model Installment {
  id            String            @id @default(uuid())
  businessId    String            @map("business_id")
  business      Business          @relation(fields: [businessId], references: [id])
  planId        String            @map("plan_id")
  plan          InstallmentPlan   @relation(fields: [planId], references: [id])
  seq           Int
  amount        Decimal           @db.Decimal(12, 2)
  dueDate       DateTime          @map("due_date") @db.Date
  status        InstallmentStatus @default(pending)
  paidAt        DateTime?         @map("paid_at")
  creditEntryId String?           @unique @map("credit_entry_id")
  creditEntry   CreditEntry?      @relation(fields: [creditEntryId], references: [id])

  @@index([businessId, dueDate])
  @@index([planId])
  @@map("installments")
}

/// Transparent ledger links (UPD-BE-022) — a long-lived (no auto-expiry, unlike the 30-day
/// review-request token), owner-revocable link a customer can use to check their own balance
/// without logging in, reusing the same opaque-random-token pattern as `review-token.util.ts`.
model CreditShareLink {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  token      String   @unique
  revoked    Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, customerId])
  @@map("credit_share_links")
}

/// Credit reminder rules (UPD-BE-095) — replaces the single manual `POST /credit/remind` action
/// with real per-business, staged configuration (days-overdue trigger, tone, channel). Same
/// pre-approved-template-vs-real-custom-text split as booking reminders (`ReminderRule`):
/// `customMessage` is honoured for SMS/email/WhatsApp-in-window, `tone` picks which pre-approved
/// template variant WhatsApp falls back to outside its 24h window.
model CreditReminderRule {
  id                String             @id @default(uuid())
  businessId        String             @map("business_id")
  business          Business           @relation(fields: [businessId], references: [id])
  daysOverdueTrigger Int               @map("days_overdue_trigger")
  tone              CreditReminderTone @default(gentle)
  channel           MessageChannel?
  customMessage     String?            @map("custom_message") @db.Text
  active            Boolean            @default(true)

  logs CreditReminderLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, active])
  @@map("credit_reminder_rules")
}

/// Idempotency log for the staged reminder job (UPD-BE-095) — one row per real send, so a debtor
/// who still matches the same rule the next tick isn't reminded again the same day. Kept
/// deliberately simple (no unique constraint on a truncated date, which MySQL/Prisma can't express
/// directly) — the job itself windows on `sentAt` at query time, same as `QueueService.todayStart`.
model CreditReminderLog {
  id         String             @id @default(uuid())
  businessId String             @map("business_id")
  business   Business           @relation(fields: [businessId], references: [id])
  customerId String             @map("customer_id")
  customer   Customer           @relation(fields: [customerId], references: [id])
  ruleId     String             @map("rule_id")
  rule       CreditReminderRule @relation(fields: [ruleId], references: [id])

  sentAt DateTime @default(now()) @map("sent_at")

  @@index([businessId, customerId, ruleId, sentAt])
  @@map("credit_reminder_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// BE-003 — Ops
// ─────────────────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(uuid())
  businessId      String            @map("business_id")
  business        Business          @relation(fields: [businessId], references: [id])
  serviceId       String            @map("service_id")
  service         Product           @relation(fields: [serviceId], references: [id])
  staffUserId     String?           @map("staff_user_id")
  staffUser       BusinessUser?     @relation("StaffAppointments", fields: [staffUserId], references: [id])
  customerId      String            @map("customer_id")
  customer        Customer          @relation(fields: [customerId], references: [id])
  startsAt        DateTime          @map("starts_at")
  endsAt          DateTime          @map("ends_at")
  status          AppointmentStatus @default(booked)
  depositPaid     Decimal           @default(0) @map("deposit_paid") @db.Decimal(12, 2)
  source          AppointmentSource @default(link)
  rescheduleToken String?           @unique @map("reschedule_token")

  deposits   Deposit[]
  phoneCalls PhoneCall[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, startsAt])
  @@index([staffUserId, startsAt])
  @@map("appointments")
}

/// Waiting List (UPD-BE-017). A "matching" freed slot means: same service (and same staff, if the
/// entry named one) as this waiting entry, checked automatically whenever an appointment is
/// cancelled — see `WaitlistService.tryAutoOffer`, called from both the internal and public
/// cancellation paths.
model WaitlistEntry {
  id            String         @id @default(uuid())
  businessId    String         @map("business_id")
  business      Business       @relation(fields: [businessId], references: [id])
  customerId    String         @map("customer_id")
  customer      Customer       @relation(fields: [customerId], references: [id])
  serviceId     String         @map("service_id")
  service       Product        @relation(fields: [serviceId], references: [id])
  staffUserId   String?        @map("staff_user_id")
  staffUser     BusinessUser?  @relation(fields: [staffUserId], references: [id])
  preferredFrom DateTime?      @map("preferred_from")
  preferredTo   DateTime?      @map("preferred_to")
  status        WaitlistStatus @default(waiting)

  offeredStartsAt DateTime? @map("offered_starts_at")
  offeredEndsAt   DateTime? @map("offered_ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, serviceId, status])
  @@map("waitlist_entries")
}

/// Queue / Tokens (UPD-BE-018) — walk-in numbering, deliberately NOT tied to `Appointment`; a
/// token is a simple "your turn" ticket, not a scheduled booking.
model QueueToken {
  id           String           @id @default(uuid())
  businessId   String           @map("business_id")
  business     Business         @relation(fields: [businessId], references: [id])
  number       Int
  customerId   String?          @map("customer_id")
  customer     Customer?        @relation(fields: [customerId], references: [id])
  customerName String?          @map("customer_name")
  serviceId    String?          @map("service_id")
  service      Product?         @relation(fields: [serviceId], references: [id])
  status       QueueTokenStatus @default(waiting)
  calledAt     DateTime?        @map("called_at")
  servedAt     DateTime?        @map("served_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("queue_tokens")
}

/// Deposits (UPD-BE-019). Cash deposits are captured/refunded for real, immediately. Card/online
/// capture is a disclosed, honest gap: `PaymentGatewayAdapter.createCheckoutSession` is hardcoded
/// to Stripe *subscription*-mode checkout for billing plans and has no one-off-charge primitive to
/// reuse — see `DepositsService.capture`.
model Deposit {
  id            String        @id @default(uuid())
  businessId    String        @map("business_id")
  business      Business      @relation(fields: [businessId], references: [id])
  appointmentId String        @map("appointment_id")
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        DepositStatus @default(pending)
  providerRef   String?       @map("provider_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, appointmentId])
  @@map("deposits")
}

/// Deposit settings (UPD-BE-091) — the trigger rule ("required after N no-shows," flat vs. %,
/// which services) the shipped capture/refund flow (`Deposit`) doesn't configure yet. One row per
/// business, same singleton pattern as `CompetitiveSettings`.
model DepositSettings {
  id                   String            @id @default(uuid())
  businessId           String            @unique @map("business_id")
  business             Business          @relation(fields: [businessId], references: [id])
  required             Boolean           @default(false)
  triggerAfterNoShows  Int?              @map("trigger_after_no_shows")
  amountType           DepositAmountType @default(flat) @map("amount_type")
  amountValue          Decimal           @default(0) @map("amount_value") @db.Decimal(12, 2)
  /// Empty = applies to every service.
  applicableServiceIds Json              @default("[]") @map("applicable_service_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("deposit_settings")
}

/// Booking Link & QR (UPD-BE-090) — the public booking page's own customisation, distinct from
/// `DepositSettings` (which governs the deposit *rule*, not page copy). One row per business.
model BookingLinkSettings {
  id               String   @id @default(uuid())
  businessId       String   @unique @map("business_id")
  business         Business @relation(fields: [businessId], references: [id])
  welcomeText      String?  @map("welcome_text") @db.Text
  /// Empty = every active service shows.
  visibleServiceIds Json    @default("[]") @map("visible_service_ids")
  brandColor       String?  @map("brand_color")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("booking_link_settings")
}

/// Booking Link & QR analytics (UPD-BE-090) — one row per real page load of the public booking
/// page (`/book/:slug`), recorded by the page itself via `POST /public/booking/:biz/visit`.
/// `source` distinguishes a direct link open from a QR scan (`?src=qr` on the page URL).
model BookingLinkVisit {
  id         String            @id @default(uuid())
  businessId String            @map("business_id")
  business   Business          @relation(fields: [businessId], references: [id])
  source     AppointmentSource @default(link)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("booking_link_visits")
}

/// Booking reminder rules (UPD-BE-092) — replaces the hardcoded `BOOKING_REMINDER_HOUR_OFFSETS`
/// constant with per-business, configurable rules. `templateKey` must be one of this app's
/// pre-approved messaging templates (see `TEMPLATE_REGISTRY`) — WhatsApp/SMS business-initiated
/// messages can't carry arbitrary freeform text, so "editing the message" means picking a
/// pre-approved variant, not writing new copy. A business with zero rules keeps the original
/// hardcoded default behaviour (24h + 2h, `booking_reminder`) — see `DEFAULT_REMINDER_RULES`.
model ReminderRule {
  id          String         @id @default(uuid())
  businessId  String         @map("business_id")
  business    Business       @relation(fields: [businessId], references: [id])
  offsetHours Int            @map("offset_hours")
  channel     MessageChannel?
  templateKey String         @default("booking_reminder") @map("template_key")
  /// Real custom wording (UPD-BE-092 fix-it), `{{customerName}}`/`{{serviceName}}`/`{{dateTime}}`
  /// placeholders. Used verbatim for SMS/email and WhatsApp inside the 24h customer-service
  /// window (see `WhatsappService`); outside that window Meta requires the pre-approved
  /// `templateKey` template instead, so this is null-safe rather than a universal override.
  customMessage String?      @map("custom_message") @db.Text
  active      Boolean        @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, active])
  @@map("reminder_rules")
}

model Message {
  id           String          @id @default(uuid())
  businessId   String          @map("business_id")
  business     Business        @relation(fields: [businessId], references: [id])
  customerId   String?         @map("customer_id")
  customer     Customer?       @relation(fields: [customerId], references: [id])
  channel      MessageChannel
  category     MessageCategory
  templateKey  String          @map("template_key")
  locale       String          @default("en")
  payload      Json            @default("{}")
  status       MessageStatus   @default(queued)
  providerRef  String?         @map("provider_ref")
  scheduledFor DateTime?       @map("scheduled_for")
  /// Real custom text (UPD-BE-092 fix-it) — when set, the worker sends this (with `{{var}}`
  /// substitution against `payload`) instead of the fixed `TEMPLATE_REGISTRY` copy for
  /// `templateKey`. `templateKey`/`category` stay populated regardless, since WhatsApp outside
  /// its 24h window still needs a real pre-approved template name to fall back to.
  customBody   String?         @map("custom_body") @db.Text

  /// Set only for campaign fan-out sends (BE-061) — drives the funnel report.
  campaignId String?   @map("campaign_id")
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, customerId])
  @@index([status, scheduledFor])
  @@map("messages")
}

/**
 * BE-016: tracks the Meta WhatsApp 24h customer-service window — replies inside it are free-form and free.
 */
model WhatsappWindow {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, customerId])
  @@map("whatsapp_windows")
}

model WebhookEvent {
  provider  String
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([provider, eventId])
  @@map("webhook_events")
}

/// MySQL migration: replaces Postgres's `pg_advisory_xact_lock`/`hashtext` (no MySQL equivalent)
/// as the transaction-scoped mutex behind `booking-lock.util.ts`'s `assertSlotAvailable`. A caller
/// does `INSERT ... ON DUPLICATE KEY UPDATE` (idempotent upsert) then `SELECT ... FOR UPDATE` on the
/// matching row inside its own `$transaction` — InnoDB's row lock is held until COMMIT/ROLLBACK,
/// giving the same transaction-scoped serialization the Postgres advisory lock provided. Not
/// tenant-scoped (its key already embeds businessId as a prefix; never queried per-tenant via CLS),
/// same category as `WebhookEvent` above.
model SlotLock {
  lockKey String @id @map("lock_key")

  @@map("slot_locks")
}

model ReviewRequest {
  id            String       @id @default(uuid())
  businessId    String       @map("business_id")
  business      Business     @relation(fields: [businessId], references: [id])
  customerId    String?      @map("customer_id")
  customer      Customer?    @relation(fields: [customerId], references: [id])
  token         String       @unique
  source        String
  sourceId      String?      @map("source_id")
  stars         Int?
  message       String?      @db.Text
  routedTo      ReviewRoute? @map("routed_to")
  reminderCount Int          @default(0) @map("reminder_count")
  respondedAt   DateTime?    @map("responded_at")

  privateFeedback PrivateFeedback[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@map("review_requests")
}

model PrivateFeedback {
  id              String         @id @default(uuid())
  businessId      String         @map("business_id")
  business        Business       @relation(fields: [businessId], references: [id])
  reviewRequestId String?        @map("review_request_id")
  reviewRequest   ReviewRequest? @relation(fields: [reviewRequestId], references: [id])
  customerId      String?        @map("customer_id")
  customer        Customer?      @relation(fields: [customerId], references: [id])
  stars           Int
  message         String?        @db.Text
  status          FeedbackStatus @default(open)
  assignedTo      String?        @map("assigned_to")
  resolutionNote  String?        @map("resolution_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@map("private_feedback")
}

model ExternalReview {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  business   Business  @relation(fields: [businessId], references: [id])
  platform   String
  externalId String    @map("external_id")
  author     String?
  stars      Int
  text       String?   @db.Text
  replyText  String?   @map("reply_text") @db.Text
  repliedAt  DateTime? @map("replied_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, platform, externalId])
  @@map("external_reviews")
}

/// Sentiment Analysis (UPD-BE-076) — one row per recurring theme found in a business's real
/// review text, regenerated daily (old rows for the business are cleared and replaced, not
/// accumulated — this is a current-state snapshot, not a history log). `exampleQuote` is always a
/// real, verbatim substring of an actual review's text, verified before being stored — never an
/// AI paraphrase — same "never fabricate" discipline as `AiInsight.sourceFigure`.
model ReviewSentimentTheme {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id])
  theme        String
  sentiment    String
  exampleQuote String   @map("example_quote") @db.Text
  reviewCount  Int      @map("review_count")

  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([businessId, generatedAt])
  @@map("review_sentiment_themes")
}

/// Video Testimonials (UPD-BE-027). `requested` -> `submitted` (customer uploads via the public,
/// token-based flow — same `loadValid(token)` pattern as `public-review.service.ts`) -> `approved`
/// or `rejected` (owner/manager only, mirroring `Return`'s pending/approved/rejected shape).
/// `videoKey` is the raw S3 object key; a signed download URL is generated fresh on every read
/// (never cached) since `S3Service.getSignedDownloadUrl` URLs expire after 24h.
model VideoTestimonial {
  id               String                 @id @default(uuid())
  businessId       String                 @map("business_id")
  business         Business               @relation(fields: [businessId], references: [id])
  customerId       String?                @map("customer_id")
  customer         Customer?              @relation(fields: [customerId], references: [id])
  token            String                 @unique
  status           VideoTestimonialStatus @default(requested)
  videoKey         String?                @map("video_key")
  caption          String?                @db.Text
  approvedByUserId String?                @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@map("video_testimonials")
}

// ─────────────────────────────────────────────────────────────────────────
// UPD-BE-M17 — AI Phone Receptionist
// ─────────────────────────────────────────────────────────────────────────

/// One provisioned Twilio Voice number per business (UPD-BE-056). Twilio's own inbound-call
/// webhook carries the dialed `To` number, not any businessId — this table is the lookup from
/// that number back to the owning business.
model PhoneNumber {
  id            String   @id @default(uuid())
  businessId    String   @unique @map("business_id")
  business      Business @relation(fields: [businessId], references: [id])
  twilioSid     String   @map("twilio_sid")
  phoneNumber   String   @unique @map("phone_number")
  provisionedAt DateTime @default(now()) @map("provisioned_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("phone_numbers")
}

/// One row per inbound call (UPD-BE-057/058/059). `transcript` is the full turn-by-turn
/// conversation (`[{speaker, text, at}]`) — always read/written as one whole per call, so a Json
/// column matches this app's established "embedded array read as a unit" convention (see
/// `Order.variations`) rather than a child table. `recordingKey` is our own S3 copy of Twilio's
/// recording, not Twilio's own URL — kept for as long as `RECORDING_RETENTION_DAYS`, then purged
/// by the daily retention job alongside the row itself.
model PhoneCall {
  id            String           @id @default(uuid())
  businessId    String           @map("business_id")
  business      Business         @relation(fields: [businessId], references: [id])
  callSid       String           @unique @map("call_sid")
  fromNumber    String           @map("from_number")
  status        PhoneCallStatus  @default(in_progress)
  outcome       PhoneCallOutcome @default(none)
  transcript    Json             @default("[]")
  recordingKey  String?          @map("recording_key")
  appointmentId String?          @map("appointment_id")
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  startedAt     DateTime         @default(now()) @map("started_at")
  endedAt       DateTime?        @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, status, startedAt])
  @@map("phone_calls")
}

enum PhoneCallStatus {
  in_progress
  completed
  missed
  transferred
}

enum PhoneCallOutcome {
  none
  booking
  message
  transfer
}

// ─────────────────────────────────────────────────────────────────────────
// UPD-BE-M9 — Marketing depth: Automations, Coupons, Vouchers
// ─────────────────────────────────────────────────────────────────────────

model Coupon {
  id         String     @id @default(uuid())
  businessId String     @map("business_id")
  business   Business   @relation(fields: [businessId], references: [id])
  code       String
  type       CouponType
  value      Decimal    @db.Decimal(10, 2)

  minOrderAmount        Decimal? @map("min_order_amount") @db.Decimal(10, 2)
  /// Caps the discount a percentage-type coupon can produce; ignored for fixed-type coupons.
  maxDiscountAmount     Decimal? @map("max_discount_amount") @db.Decimal(10, 2)
  usageLimit            Int?     @map("usage_limit")
  usageLimitPerCustomer Int?     @map("usage_limit_per_customer")
  usedCount             Int      @default(0) @map("used_count")

  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  active    Boolean   @default(true)

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, code])
  @@index([businessId, active])
  @@map("coupons")
}

/// Vouchers (UPD-BE-030) — a store-credit-style balance issued once and redeemable across
/// multiple sales until it hits zero, unlike a Coupon which is a single discount rule.
model Voucher {
  id           String        @id @default(uuid())
  businessId   String        @map("business_id")
  business     Business      @relation(fields: [businessId], references: [id])
  code         String
  customerId   String?       @map("customer_id")
  customer     Customer?     @relation(fields: [customerId], references: [id])
  initialValue Decimal       @map("initial_value") @db.Decimal(10, 2)
  balance      Decimal       @db.Decimal(10, 2)
  status       VoucherStatus @default(active)
  expiresAt    DateTime?     @map("expires_at")

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, code])
  @@index([businessId, status])
  @@map("vouchers")
}

/// Automations engine (UPD-BE-028) — a workflow is one trigger + conditions + actions rule.
/// `conditions`/`actions` are intentionally untyped JSON (small, evolving shapes) rather than
/// their own relational tables, mirroring `Business.referralSettings`'s precedent for this kind
/// of business-configurable-rule data.
model Workflow {
  id         String             @id @default(uuid())
  businessId String             @map("business_id")
  business   Business           @relation(fields: [businessId], references: [id])
  name       String
  triggerKey WorkflowTriggerKey @map("trigger_key")
  /// `{ field: string; operator: 'eq'|'neq'|'gt'|'gte'|'lt'|'lte'|'contains'; value: string|number }[]`
  conditions Json               @default("[]")
  /// `{ type: 'send_customer_message'|'notify_owner'; messageBody: string }[]`
  actions    Json               @default("[]")
  active     Boolean            @default(true)

  runs WorkflowRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, triggerKey, active])
  @@map("workflows")
}

model WorkflowRun {
  id         String            @id @default(uuid())
  workflowId String            @map("workflow_id")
  workflow   Workflow          @relation(fields: [workflowId], references: [id])
  businessId String            @map("business_id")
  business   Business          @relation(fields: [businessId], references: [id])
  status     WorkflowRunStatus
  context    Json
  result     Json?
  error      String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, workflowId, createdAt])
  @@map("workflow_runs")
}

// ─────────────────────────────────────────────────────────────────────────
// BE-004 — Inventory & finance
// ─────────────────────────────────────────────────────────────────────────

model StockMovement {
  id          String            @id @default(uuid())
  businessId  String            @map("business_id")
  business    Business          @relation(fields: [businessId], references: [id])
  productId   String            @map("product_id")
  product     Product           @relation(fields: [productId], references: [id])
  kind        StockMovementKind
  qty         Int
  unitCost    Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  /// Free-text supplier name — kept for movements recorded before UPD-BE-014 formalized suppliers,
  /// and as a fallback for anyone not yet using the Supplier directory.
  supplier    String?
  /// Formal supplier reference (UPD-BE-014), set by supplier-driven purchases (quick-PO). Optional
  /// and independent of `supplier` above — a movement may have either, both, or neither.
  supplierId  String?           @map("supplier_id")
  supplierRef Supplier?         @relation(fields: [supplierId], references: [id])
  reason      String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, productId])
  @@map("stock_movements")
}

/// Stock Transfers (UPD-BE-036) — deliberately EXCLUDED from `TENANT_SCOPED_MODELS`. A transfer
/// inherently spans two businesses (source and destination branch); `TenantPrismaService`'s CLS
/// scoping would force every query to just the caller's own business, so `StockTransfersService`
/// uses the raw `PrismaService` throughout with explicit `sourceBusinessId`/`destBusinessId`
/// checks — same pattern as `RollupService`, the only other code that reads across branches.
model StockTransfer {
  id               String              @id @default(uuid())
  sourceBusinessId String              @map("source_business_id")
  sourceBusiness   Business            @relation("StockTransferSource", fields: [sourceBusinessId], references: [id])
  destBusinessId   String              @map("dest_business_id")
  destBusiness     Business            @relation("StockTransferDest", fields: [destBusinessId], references: [id])
  status           StockTransferStatus @default(pending)
  note             String?

  requestedByUserId String? @map("requested_by_user_id")
  approvedByUserId  String? @map("approved_by_user_id")
  shippedByUserId   String? @map("shipped_by_user_id")
  receivedByUserId  String? @map("received_by_user_id")

  items StockTransferItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sourceBusinessId, status])
  @@index([destBusinessId, status])
  @@map("stock_transfers")
}

/// References only the SOURCE branch's product — the destination-branch product is resolved
/// dynamically by matching SKU at approve()/receive() time, since branches don't share product
/// identity (see `Product.businessId`, a hard per-business scalar).
model StockTransferItem {
  id              String        @id @default(uuid())
  transferId      String        @map("transfer_id")
  transfer        StockTransfer @relation(fields: [transferId], references: [id])
  sourceProductId String        @map("source_product_id")
  sourceProduct   Product       @relation(fields: [sourceProductId], references: [id])
  qty             Int

  createdAt DateTime @default(now()) @map("created_at")

  @@map("stock_transfer_items")
}

enum StockCountStatus {
  draft
  applied
}

/// Stock Count (UPD-BE-037) — a physical count is entered as a `draft` (lines snapshot the
/// expected/counted/variance at the moment of entry, purely for preview), and only
/// `apply()` actually moves stock: it re-derives variance against the live `Product.stockQty`
/// at that moment (not the stale creation-time snapshot, in case real sales/other movements
/// happened in between) and writes one real `StockMovement` (kind `adjustment`) per line that
/// still has a nonzero variance. Same "approval is the one moment real stock moves" shape as
/// `Return`/`StockTransfer`.
model StockCount {
  id         String           @id @default(uuid())
  businessId String           @map("business_id")
  business   Business         @relation(fields: [businessId], references: [id])
  status     StockCountStatus @default(draft)
  note       String?

  createdByUserId String?   @map("created_by_user_id")
  appliedByUserId String?   @map("applied_by_user_id")
  appliedAt       DateTime? @map("applied_at")

  lines StockCountLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id           String     @id @default(uuid())
  stockCountId String     @map("stock_count_id")
  stockCount   StockCount @relation(fields: [stockCountId], references: [id])
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  /// Snapshot of `Product.stockQty` at creation time — preview only, re-derived live at apply().
  expectedQty  Int        @map("expected_qty")
  countedQty   Int        @map("counted_qty")
  /// countedQty - expectedQty, snapshotted at creation time — the authoritative variance is
  /// recomputed against live stock inside apply(), never trusted from this stored value.
  variance     Int

  createdAt DateTime @default(now()) @map("created_at")

  @@map("stock_count_lines")
}

/// Reusable variant templates (UPD-BE-012) — e.g. a "Size" set with Small/Medium/Large options,
/// defined once and applied to many products via `POST /variants/:id/apply`, which writes into
/// the pre-existing informal `Product.variations` JSON field (unchanged shape, still consumed
/// as-is at sale time) rather than replacing it — this is the formal *source*, not a new runtime
/// representation products are read through.
model VariantSet {
  id         String          @id @default(uuid())
  businessId String          @map("business_id")
  business   Business        @relation(fields: [businessId], references: [id])
  name       String
  options    VariantOption[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, name])
  @@map("variant_sets")
}

model VariantOption {
  id            String     @id @default(uuid())
  variantSetId  String     @map("variant_set_id")
  variantSet    VariantSet @relation(fields: [variantSetId], references: [id])
  name          String
  priceOverride Decimal?   @map("price_override") @db.Decimal(12, 2)
  /// MySQL migration: SQL row order without an explicit ORDER BY is undefined, and unlike
  /// Postgres's incidental near-insertion-order behavior for a small unindexed table, MySQL's
  /// InnoDB clusters rows by primary key (UUID) — meaning fetching without this and an `orderBy`
  /// would return options in effectively random order. Assigned by array index in
  /// `variants.service.ts`, same convention as `Option.sortOrder`.
  sortOrder     Int        @default(0) @map("sort_order")

  @@index([variantSetId])
  @@map("variant_options")
}

/// Bundles (UPD-BE-013). Every bundle has its own real, sellable `Product` row (kind `product`) —
/// selling it decrements only the bundle's OWN stock, not each component's; components exist here
/// purely to compute true rolled-up cost/margin and to drive `GET /profit/bundle-suggestions`.
/// Cascading a bundle sale into per-component stock decrements is a deliberately out-of-scope,
/// disclosed gap — this models "pre-kitted" bundles (built and stocked ahead of time), not
/// build-on-demand ones.
model Bundle {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  business   Business     @relation(fields: [businessId], references: [id])
  productId  String       @unique @map("product_id")
  product    Product      @relation(fields: [productId], references: [id])
  items      BundleItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(uuid())
  bundleId  String  @map("bundle_id")
  bundle    Bundle  @relation(fields: [bundleId], references: [id])
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  qty       Int

  @@index([bundleId])
  @@map("bundle_items")
}

/// Formal supplier directory (UPD-BE-014) — until now a supplier was only ever a free-text field
/// on `StockMovement` (see `supplier` above); this is the first real, addressable supplier entity.
model Supplier {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?  @db.Text

  stockMovements StockMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("suppliers")
}

/// Categories, formalized (UPD-BE-088). Replaces `Product.category`'s free-text field as the
/// canonical source going forward — the old field is kept unchanged for backward compatibility
/// with existing readers (exports, filters) but new code should prefer `Product.categoryId`.
model Category {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  sortOrder  Int      @default(0) @map("sort_order")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

enum ScheduledExportFrequency {
  weekly
  monthly
}

/// Schedule recurring export (UPD-FE-071). `kind`/`format` are free-text strings (not enums)
/// mirroring `ExportKind`/`ExportFormat` in exports.constants.ts, validated at the DTO layer —
/// kept as strings here so a new export kind/format never needs a schema migration to schedule.
model ScheduledExport {
  id              String                   @id @default(uuid())
  businessId      String                   @map("business_id")
  business        Business                 @relation(fields: [businessId], references: [id])
  kind            String
  format          String
  frequency       ScheduledExportFrequency
  active          Boolean                  @default(true)
  createdByUserId String?                  @map("created_by_user_id")
  lastRunAt       DateTime?                @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("scheduled_exports")
}

/// Selling-price change log (UPD-BE-015) — written every time `Product.sellingPrice` changes via
/// the bulk pricing tool, so a price change is always explainable after the fact.
model PriceHistory {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id])
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])
  oldPrice        Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice        Decimal  @map("new_price") @db.Decimal(12, 2)
  changedByUserId String?  @map("changed_by_user_id")
  note            String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, productId])
  @@map("price_history")
}

model Expense {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id])
  description String   @db.Text
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  recurring   Boolean  @default(false)
  incurredOn  DateTime @map("incurred_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, incurredOn])
  @@map("expenses")
}

enum RecurringObligationFrequency {
  weekly
  biweekly
  monthly
  quarterly
  yearly
}

/// Cash Flow forecasting (UPD-BE-078) — a real, schedulable future obligation (rent, payroll,
/// loan repayment, subscription), distinct from `Expense.recurring` (a historical tag on an
/// already-incurred cost with no forward schedule). `nextDueDate` advances by `frequency` each
/// time the forecast walks past it — see `CashForecastService`.
model RecurringObligation {
  id          String                       @id @default(uuid())
  businessId  String                       @map("business_id")
  business    Business                     @relation(fields: [businessId], references: [id])
  name        String
  amount      Decimal                      @db.Decimal(12, 2)
  frequency   RecurringObligationFrequency
  nextDueDate DateTime                     @map("next_due_date") @db.Date
  category    String?
  active      Boolean                      @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, active])
  @@map("recurring_obligations")
}

/// SEO Heatmap (UPD-BE-080) — one real local-pack rank check at one real grid point around the
/// business's geocoded address, for one keyword. `scanId` groups every point from the same
/// `POST /seo/heatmap/scan` run (their individual `scannedAt` timestamps can differ by seconds).
model SeoHeatmapPoint {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  scanId     String   @map("scan_id")
  keyword    String
  lat        Float
  lng        Float
  /// NULL = the business did not appear in the local pack results at this point — never a fabricated rank.
  rank       Int?

  scannedAt DateTime @default(now()) @map("scanned_at")

  @@index([businessId, keyword, scanId])
  @@map("seo_heatmap_points")
}

/// Developer & API (UPD-BE-081) — a real bearer credential distinct from the JWT session tokens
/// issued at login: `keyHash` is a SHA-256 digest (never the plaintext secret, shown to the owner
/// exactly once at creation); `keyPrefix` is a safe, non-secret slice kept for the key list UI to
/// identify which key is which. `scopes` are real `CAPABILITIES` strings — `JwtAuthGuard` resolves
/// a `Bearer ntk_...` request straight to these scopes as its `AuthenticatedUser.capabilities`,
/// so every existing `@RequireCapability(...)` route gate already enforces them, no separate
/// authorization path needed.
model ApiKey {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  business   Business  @relation(fields: [businessId], references: [id])
  name       String
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  scopes     Json      @default("[]")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@map("api_keys")
}

/// Nightly Close history (UPD-BE-083) — one row per real send attempt, written by
/// `NightlyCloseService.composeAndSend()` regardless of outcome, so a failed delivery is visible
/// rather than silently absent. `@@unique([businessId, closeDate])` makes a same-day retry
/// (the processor's own idempotency-keyed re-run) an update, not a duplicate history row.
model NightlyCloseLog {
  id         String         @id @default(uuid())
  businessId String         @map("business_id")
  business   Business       @relation(fields: [businessId], references: [id])
  closeDate  DateTime       @map("close_date") @db.Date
  channel    MessageChannel
  status     String
  error      String?        @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, closeDate])
  @@index([businessId, createdAt])
  @@map("nightly_close_logs")
}

model Attendance {
  id          String       @id @default(uuid())
  businessId  String       @map("business_id")
  business    Business     @relation(fields: [businessId], references: [id])
  staffUserId String       @map("staff_user_id")
  staffUser   BusinessUser @relation(fields: [staffUserId], references: [id])
  checkIn     DateTime     @map("check_in")
  checkOut    DateTime?    @map("check_out")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, staffUserId])
  @@map("attendance")
}

// ─────────────────────────────────────────────────────────────────────────
// UPD-BE-M10 — Staff depth: Shifts, Time Off, Timesheets, Advances
// ─────────────────────────────────────────────────────────────────────────

enum StaffShiftStatus {
  scheduled
  completed
  cancelled
}

enum ShiftSwapStatus {
  pending
  approved
  rejected
}

/// Roster (UPD-BE-031). Swap-request fields are embedded directly on the shift (a shift has at
/// most one active swap request at a time) rather than a separate model — mirrors the plain,
/// non-FK `approvedByUserId`-style reviewer-reference convention already used on `VideoTestimonial`.
model StaffShift {
  id          String           @id @default(uuid())
  businessId  String           @map("business_id")
  business    Business         @relation(fields: [businessId], references: [id])
  staffUserId String           @map("staff_user_id")
  staffUser   BusinessUser     @relation(fields: [staffUserId], references: [id])
  startsAt    DateTime         @map("starts_at")
  endsAt      DateTime         @map("ends_at")
  status      StaffShiftStatus @default(scheduled)
  note        String?

  swapStatus            ShiftSwapStatus? @map("swap_status")
  swapRequestedByUserId String?          @map("swap_requested_by_user_id")
  swapCoveringUserId    String?          @map("swap_covering_user_id")
  swapReason            String?          @map("swap_reason")
  swapReviewedByUserId  String?          @map("swap_reviewed_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, staffUserId, startsAt])
  @@map("staff_shifts")
}

/// UPD-BE-031. Real code, deliberately simple: a request + owner/manager approve/reject, same
/// shape as `Return`'s raise-then-approve pattern.
model TimeOff {
  id               String       @id @default(uuid())
  businessId       String       @map("business_id")
  business         Business     @relation(fields: [businessId], references: [id])
  staffUserId      String       @map("staff_user_id")
  staffUser        BusinessUser @relation(fields: [staffUserId], references: [id])
  startsAt         DateTime     @map("starts_at")
  endsAt           DateTime     @map("ends_at")
  reason           String?
  approved         Boolean      @default(false)
  reviewedByUserId String?      @map("reviewed_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, staffUserId])
  @@map("time_off")
}

/// UPD-BE-032. Timesheets themselves are computed live from `Attendance`/`StaffShift`, never
/// stored — this is only the persisted "has this staff member's month been approved" marker.
model TimesheetApproval {
  id               String       @id @default(uuid())
  businessId       String       @map("business_id")
  business         Business     @relation(fields: [businessId], references: [id])
  staffUserId      String       @map("staff_user_id")
  staffUser        BusinessUser @relation(fields: [staffUserId], references: [id])
  /// "YYYY-MM", same convention as `CommissionsService.report(month)`.
  month            String
  approvedByUserId String?      @map("approved_by_user_id")
  approvedAt       DateTime?    @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, staffUserId, month])
  @@map("timesheet_approvals")
}

enum StaffAdvanceStatus {
  outstanding
  deducted
  cancelled
}

/// UPD-BE-033. "Auto-deducted from the next commission payout" — since there's no persisted
/// payout/mutation action anywhere in this codebase today (`CommissionsService.report()` is a
/// read-only projection), Payroll Export (UPD-BE-034) is the one real place a payout is
/// materialized, so that's where outstanding advances actually get netted and flipped to
/// `deducted`, stamped with the month they were applied against.
model StaffAdvance {
  id              String             @id @default(uuid())
  businessId      String             @map("business_id")
  business        Business           @relation(fields: [businessId], references: [id])
  staffUserId     String             @map("staff_user_id")
  staffUser       BusinessUser       @relation(fields: [staffUserId], references: [id])
  amount          Decimal            @db.Decimal(12, 2)
  reason          String?
  status          StaffAdvanceStatus @default(outstanding)
  deductedInMonth String?            @map("deducted_in_month")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, staffUserId, status])
  @@map("staff_advances")
}

// ─────────────────────────────────────────────────────────────────────────
// UPD-BE-035 — Roles & Permissions matrix
// ─────────────────────────────────────────────────────────────────────────

/// A business-defined role: a named, chosen subset of the fixed capability vocabulary (see
/// `common/capabilities/capabilities.constants.ts` — not modeled as its own table since
/// capabilities are a fixed, code-level vocabulary tied to real routes, not user-editable data).
/// The 3 system roles (owner/manager/staff) are never rows here — they're built-in defaults
/// with a hardcoded capability set (`SYSTEM_ROLE_CAPABILITIES`) that exactly reproduces this
/// codebase's real access model prior to this ticket, so assigning nobody a custom role changes
/// nothing.
model CustomRole {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  /// MySQL migration: was a native `String[]` array (Postgres-only) — see `Customer.tags`'s doc
  /// comment for why. Read/written wholesale in JS (see `roles.service.ts`).
  capabilities Json

  businessUsers BusinessUser[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, name])
  @@map("custom_roles")
}

/// Terminology Engine (UPD-BE-038) — one row per overridden term. `area` scopes the same `key`
/// to render differently across surfaces (e.g. `general` for WhatsApp messages via
/// `{{term:key}}`, `pdf` for generated documents) — a business can rename "Customer" to "Client"
/// everywhere via `general`, or override just the invoice's wording via `pdf` without touching
/// WhatsApp copy. Real defaults live in code (`DEFAULT_TERMS`), not the database — a row here
/// only exists once a business actually overrides that term.
model LabelOverride {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  area       String
  key        String
  value      String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, area, key])
  @@map("label_overrides")
}

/// Custom Options manager (UPD-BE-039) — net-new (no prior `CRUD /options/:setKey` existed to
/// generalize, confirmed by research). `setKey` is a free string a business chooses when creating
/// a set (e.g. "product_category") — not yet wired as validation on `Product.category`/
/// `Expense.category`'s free-text columns; this is the standalone list-management feature itself.
model OptionSet {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  setKey     String   @map("set_key")
  label      String

  options Option[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, setKey])
  @@map("option_sets")
}

model Option {
  id          String    @id @default(uuid())
  optionSetId String    @map("option_set_id")
  optionSet   OptionSet @relation(fields: [optionSetId], references: [id])
  value       String
  sortOrder   Int       @default(0) @map("sort_order")
  hidden      Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([optionSetId])
  @@map("options")
}

model Campaign {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  business     Business  @relation(fields: [businessId], references: [id])
  segment      String
  templateKey  String    @map("template_key")
  body         String    @db.Text
  scheduledFor DateTime? @map("scheduled_for")
  sentCount    Int       @default(0) @map("sent_count")

  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("campaigns")
}

model Competitor {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  business         Business @relation(fields: [businessId], references: [id])
  platformRef      String   @map("platform_ref")
  lastRating       Decimal? @map("last_rating") @db.Decimal(2, 1)
  lastReviewsCount Int?     @map("last_reviews_count")
  /// Facebook Page ID (UPD-BE-053) — optional, only needed for `GET /competitors/:id/ads`'s Meta
  /// Ad Library lookup. Left unset, that endpoint returns an empty, honestly-disclosed result
  /// rather than guessing a page from the Google-Place-based `platformRef`.
  metaPageId       String?  @map("meta_page_id")

  snapshots CompetitorSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("competitors")
}

/// Historical weekly rating snapshots (BE-063 real backend) — Competitor itself only ever holds the latest values.
model CompetitorSnapshot {
  id           String     @id @default(uuid())
  competitorId String     @map("competitor_id")
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  rating       Decimal    @db.Decimal(2, 1)
  reviewsCount Int        @map("reviews_count")
  capturedAt   DateTime   @default(now()) @map("captured_at")

  @@index([competitorId, capturedAt])
  @@map("competitor_snapshots")
}

/// Weekly Business Health Score history (UPD-BE-001) — each component stored as its weighted
/// 0-weight contribution (default 0-25) plus the summed 0-100 total, so the 12-week trend and the
/// "what changed" breakdown both read straight off this table without recomputing history.
model HealthScoreSnapshot {
  id                  String   @id @default(uuid())
  businessId          String   @map("business_id")
  business            Business @relation(fields: [businessId], references: [id])
  ratingTrendScore    Decimal  @map("rating_trend_score") @db.Decimal(5, 2)
  repeatCustomerScore Decimal  @map("repeat_customer_score") @db.Decimal(5, 2)
  marginScore         Decimal  @map("margin_score") @db.Decimal(5, 2)
  creditRecoveryScore Decimal  @map("credit_recovery_score") @db.Decimal(5, 2)
  totalScore          Decimal  @map("total_score") @db.Decimal(5, 2)
  capturedAt          DateTime @default(now()) @map("captured_at")

  @@index([businessId, capturedAt])
  @@map("health_score_snapshots")
}

/// Business Health Score, weight-change log (UPD-BE-001e) — one row per real
/// `PATCH /health-score/weights` call, capturing the score immediately before and after so "what
/// changed" is answerable without recomputing history. Distinct from `HealthScoreSnapshot`, which
/// is a plain weekly time series with no notion of *why* the score moved.
model HealthScoreWeightChange {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  business        Business @relation(fields: [businessId], references: [id])
  oldWeights      Json     @map("old_weights")
  newWeights      Json     @map("new_weights")
  oldScore        Decimal  @map("old_score") @db.Decimal(5, 2)
  newScore        Decimal  @map("new_score") @db.Decimal(5, 2)
  changedByUserId String?  @map("changed_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("health_score_weight_changes")
}

/// Live Activity feed (UPD-BE-002) — a permanent event log written by every real mutation point
/// (sale/booking/review/payment/complaint/stock), read by the Dashboard's live feed (SSE tail),
/// and later by the Automations engine (UPD-BE-028) as its trigger source.
model ActivityEvent {
  id          String            @id @default(uuid())
  businessId  String            @map("business_id")
  business    Business          @relation(fields: [businessId], references: [id])
  type        ActivityEventType
  description String            @db.Text
  amount      Decimal?          @db.Decimal(12, 2)
  entityType  String?           @map("entity_type")
  entityId    String?           @map("entity_id")
  actorUserId String?           @map("actor_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("activity_events")
}

/// AI Insights (UPD-BE-003) — one row per generated observation. `sourceFigure` is always computed
/// deterministically server-side from real data BEFORE the AI call, never trusted from the model's
/// own output, so every insight is verifiably tied to a real number even though its phrasing is AI-written.
model AiInsight {
  id           String            @id @default(uuid())
  businessId   String            @map("business_id")
  business     Business          @relation(fields: [businessId], references: [id])
  category     AiInsightCategory
  observation  String
  sourceFigure String            @map("source_figure")
  status       AiInsightStatus   @default(new)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status, createdAt])
  @@map("ai_insights")
}

/// Action Center (UPD-BE-004) — synthesized action items (complaints/low-stock/overdue-credit/
/// unreplied-reviews) are always freshly queried from their real source tables, mirroring the
/// read-only Staff Inbox synthesis pattern from v1 INT-009. This model exists ONLY to persist the
/// one thing Staff Inbox never needed: per-item complete/snooze/dismiss state, keyed by
/// (type, entityId) rather than duplicating the underlying record. A row's absence means "open".
model ActionItemState {
  id           String           @id @default(uuid())
  businessId   String           @map("business_id")
  business     Business         @relation(fields: [businessId], references: [id])
  type         ActionItemType
  entityId     String           @map("entity_id")
  status       ActionItemStatus
  snoozedUntil DateTime?        @map("snoozed_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, type, entityId])
  @@map("action_item_states")
}

/// Keyword rank tracking (new, BE-063 extension) — a business's own tracked search terms.
model TrackedKeyword {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  keyword    String

  snapshots KeywordRankSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, keyword])
  @@map("tracked_keywords")
}

model KeywordRankSnapshot {
  id         String         @id @default(uuid())
  keywordId  String         @map("keyword_id")
  keyword    TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  /// Null means not found in the checked results window.
  rank       Int?
  capturedAt DateTime       @default(now()) @map("captured_at")

  @@index([keywordId, capturedAt])
  @@map("keyword_rank_snapshots")
}

/// Weekly Visibility Score history (UPD-BE-052) — same shape as `HealthScoreSnapshot`: each
/// component stored as its 0-100 raw score (equal-quarter weighting, no per-business customization
/// unlike the Health Score) plus the summed 0-100 total.
model VisibilityScoreSnapshot {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id])
  listingScore Decimal  @map("listing_score") @db.Decimal(5, 2)
  reviewScore  Decimal  @map("review_score") @db.Decimal(5, 2)
  seoScore     Decimal  @map("seo_score") @db.Decimal(5, 2)
  socialScore  Decimal  @map("social_score") @db.Decimal(5, 2)
  totalScore   Decimal  @map("total_score") @db.Decimal(5, 2)
  capturedAt   DateTime @default(now()) @map("captured_at")

  @@index([businessId, capturedAt])
  @@map("visibility_score_snapshots")
}

/// Competitive Insights gap analysis (UPD-BE-054) — one row per detected gap, generated weekly
/// (and via a manual "refresh now") by `CompetitiveOpportunitiesService`. `evidence` is always the
/// real, deterministically-computed fact (mirrors `AiInsight.sourceFigure`); `recommendation` is
/// the AI-phrased action built ONLY from that evidence, falling back to the evidence text itself
/// if the AI call fails — never a fabricated figure either way.
model CompetitiveOpportunity {
  id             String                     @id @default(uuid())
  businessId     String                     @map("business_id")
  business       Business                   @relation(fields: [businessId], references: [id])
  kind           CompetitiveOpportunityKind
  evidence       String                     @db.Text
  /// What the evidence is about — a keyword string, a directory provider name, or a social
  /// platform — so the frontend can deep-link the opportunity to its real source screen.
  evidenceRef    String?                    @map("evidence_ref")
  recommendation String?                    @db.Text
  dismissed      Boolean                    @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, dismissed, createdAt])
  @@map("competitive_opportunities")
}

/// Competitive Settings (UPD-BE-055) — one row per business (upsert-on-write, same pattern as
/// `SocialSettings`/`MasterListing`).
model CompetitiveSettings {
  id                        String   @id @default(uuid())
  businessId                String   @unique @map("business_id")
  business                  Business @relation(fields: [businessId], references: [id])
  scanFrequencyDays         Int      @default(7) @map("scan_frequency_days")
  keywordRankAlertThreshold Int      @default(10) @map("keyword_rank_alert_threshold")
  reviewFreshnessAlertDays  Int      @default(14) @map("review_freshness_alert_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("competitive_settings")
}

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id])
  actorUserId String?  @map("actor_user_id")
  action      String
  entity      String
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, entity, entityId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────
// BE-005 — New tables (import, integrations hub, ads/email/feed)
// ─────────────────────────────────────────────────────────────────────────

model ImportBatch {
  id            String       @id @default(uuid())
  businessId    String       @map("business_id")
  business      Business     @relation(fields: [businessId], references: [id])
  source        ImportSource
  status        ImportStatus @default(pending)
  counts        Json         @default("{}")
  /**
   * Staged, normalized rows with a per-row action (create/update/skip) — powers preview + confirm/execute.
   * For `source = photo` (UPD-BE-060), each row is instead a `DigitizerRow`
   * (`{id, destination, data, confidence, corrected, action}`) — a different shape sharing this
   * same stage-then-commit column, addressed individually via `PATCH /digitizer/rows/:id`.
   */
  rows          Json         @default("[]")
  /// Import Customers, column-mapping (UPD-BE-099) — the raw, header-keyed rows behind a CSV/XLSX
  /// customer-import batch, kept alongside the already-staged `rows` so the batch can be re-staged
  /// under a corrected column mapping without re-uploading. Null for every other source.
  rawRows       Json?        @map("raw_rows")
  errorsFileUrl String?      @map("errors_file_url")
  contentHash   String       @map("content_hash")
  /// UPD-BE-060: which digitizer scanner type produced this batch — null for every non-photo source.
  scannerType   String?      @map("scanner_type")
  /// UPD-BE-060: S3 key of the original uploaded photo — null for every non-photo source.
  imageKey      String?      @map("image_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, contentHash])
  @@map("import_batches")
}

/// AI Photo Digitizer learned aliases (UPD-BE-063) — when an owner corrects a vision-extracted
/// name during review, that correction is remembered per-business and applied automatically to
/// future scans' raw extraction output before staging, so a recurring misread only needs fixing once.
model DigitizerAlias {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  business      Business @relation(fields: [businessId], references: [id])
  rawText       String   @map("raw_text")
  correctedText String   @map("corrected_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, rawText])
  @@map("digitizer_aliases")
}

// ─────────────────────────────────────────────────────────────────────────
// UPD-BE-M19 — Delivery & Riders
// ─────────────────────────────────────────────────────────────────────────

model Rider {
  id             String      @id @default(uuid())
  businessId     String      @map("business_id")
  business       Business    @relation(fields: [businessId], references: [id])
  name           String
  phone          String
  status         RiderStatus @default(active)
  /// Last GPS fix pushed by the rider's own device (UPD-BE-065 live tracking) — null until their first check-in.
  lastLat        Decimal?    @map("last_lat") @db.Decimal(9, 6)
  lastLng        Decimal?    @map("last_lng") @db.Decimal(9, 6)
  lastLocationAt DateTime?   @map("last_location_at")

  deliveries Delivery[]
  routes     Route[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@map("riders")
}

enum RiderStatus {
  active
  inactive
}

/// One per delivery order (UPD-BE-065), 1:1 with the `Order` it fulfills. `routeSequence` is this
/// delivery's stop position within its `Route`, when it has one — a real ordering column (not
/// implicit array order), same MySQL-row-ordering-safety reasoning as `VariantOption.sortOrder`.
model Delivery {
  id                String         @id @default(uuid())
  businessId        String         @map("business_id")
  business          Business       @relation(fields: [businessId], references: [id])
  orderId           String         @unique @map("order_id")
  order             Order          @relation(fields: [orderId], references: [id])
  riderId           String?        @map("rider_id")
  rider             Rider?         @relation(fields: [riderId], references: [id])
  status            DeliveryStatus @default(unassigned)
  addressLine       String         @map("address_line") @db.Text
  lat               Decimal?       @db.Decimal(9, 6)
  lng               Decimal?       @db.Decimal(9, 6)
  routeId           String?        @map("route_id")
  route             Route?         @relation(fields: [routeId], references: [id])
  routeSequence     Int?           @map("route_sequence")
  proofSignatureKey String?        @map("proof_signature_key")
  proofPhotoKey     String?        @map("proof_photo_key")
  proofLat          Decimal?       @map("proof_lat") @db.Decimal(9, 6)
  proofLng          Decimal?       @map("proof_lng") @db.Decimal(9, 6)
  proofAt           DateTime?      @map("proof_at")
  assignedAt        DateTime?      @map("assigned_at")
  deliveredAt       DateTime?      @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@map("deliveries")
}

enum DeliveryStatus {
  unassigned
  assigned
  picked_up
  en_route
  delivered
  failed
}

/// Multi-stop rider route (UPD-BE-066) — `POST /routes/:id/optimise` reorders its deliveries'
/// `routeSequence` via nearest-neighbour, real straight-line distance always available, refined by
/// a real maps/geocoding provider when `MAPS_PROVIDER_API_KEY` is configured (disclosed gap otherwise).
model Route {
  id         String      @id @default(uuid())
  businessId String      @map("business_id")
  business   Business    @relation(fields: [businessId], references: [id])
  riderId    String?     @map("rider_id")
  rider      Rider?      @relation(fields: [riderId], references: [id])
  status     RouteStatus @default(planned)

  deliveries Delivery[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("routes")
}

enum RouteStatus {
  planned
  in_progress
  completed
}

/// Delivery charge rules by zone (UPD-BE-068) — a thin settings CRUD, not wired into POS pricing
/// by this ticket (that's a distinct future integration, out of this ticket's own scope).
model DeliveryZone {
  id                  String             @id @default(uuid())
  businessId          String             @map("business_id")
  business            Business           @relation(fields: [businessId], references: [id])
  name                String
  chargeType          DeliveryChargeType @map("charge_type")
  flatAmount          Decimal?           @map("flat_amount") @db.Decimal(10, 2)
  perKmAmount         Decimal?           @map("per_km_amount") @db.Decimal(10, 2)
  freeAboveOrderValue Decimal?           @map("free_above_order_value") @db.Decimal(10, 2)
  active              Boolean            @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("delivery_zones")
}

enum DeliveryChargeType {
  flat
  by_distance
  by_order_value
}

model Integration {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  business   Business            @relation(fields: [businessId], references: [id])
  provider   IntegrationProvider
  status     IntegrationStatus   @default(not_connected)
  /// `@db.Text` (UPD-BE-072 bug fix): a real encrypted `{accessToken, refreshToken, expiresAt,
  /// providerMeta}` blob routinely exceeds MySQL's default VARCHAR(191) once AES-256-GCM + base64
  /// overhead is applied — a real Google/Meta access+refresh token pair alone is often 200+ chars
  /// each. Found live: WooCommerce's connect flow overflowed the column and failed with a real
  /// Prisma P2000 error.
  tokens     String?             @db.Text
  meta       Json                @default("{}")

  adCampaigns AdCampaign[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, provider])
  @@map("integrations")
}

model AdCampaign {
  id            String              @id @default(uuid())
  businessId    String              @map("business_id")
  business      Business            @relation(fields: [businessId], references: [id])
  integrationId String?             @map("integration_id")
  integration   Integration?        @relation(fields: [integrationId], references: [id])
  provider      IntegrationProvider
  goal          String
  budget        Decimal             @db.Decimal(12, 2)
  status        String              @default("draft")
  externalId    String?             @map("external_id")
  stats         Json                @default("{}")

  creatives AdCreative[]
  leads     AdLead[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("ad_campaigns")
}

/// Ad Creatives (UPD-BE-070) — `sourceReviewId` is set when this creative was built from a real
/// customer review (the "review-to-ad" flow the ticket calls out, reusing Meta's proven creative
/// render path from v1 INT-013).
model AdCreative {
  id             String              @id @default(uuid())
  businessId     String              @map("business_id")
  business       Business            @relation(fields: [businessId], references: [id])
  campaignId     String?             @map("campaign_id")
  campaign       AdCampaign?         @relation(fields: [campaignId], references: [id])
  provider       IntegrationProvider
  headline       String
  body           String              @db.Text
  mediaKey       String?             @map("media_key")
  sourceReviewId String?             @map("source_review_id")
  externalId     String?             @map("external_id")
  status         String              @default("draft")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("ad_creatives")
}

/// Ad Audiences (UPD-BE-070) — `segmentKey` links back to the existing CRM segment
/// (`SegmentsService`) this audience was built from, when it was; a consent check (excluding
/// opted-out customers) always runs before sync, real either way.
model AdAudience {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  business   Business            @relation(fields: [businessId], references: [id])
  provider   IntegrationProvider
  name       String
  segmentKey String?             @map("segment_key")
  size       Int                 @default(0)
  externalId String?             @map("external_id")
  status     String              @default("local")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("ad_audiences")
}

/// Lead Inbox (UPD-BE-071) — one row per real lead-gen form submission, ingested via each
/// provider's real lead webhook (reuses the idempotent-webhook pattern from `webhooks/`).
model AdLead {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  business   Business            @relation(fields: [businessId], references: [id])
  campaignId String?             @map("campaign_id")
  campaign   AdCampaign?         @relation(fields: [campaignId], references: [id])
  provider   IntegrationProvider
  name       String?
  email      String?
  phone      String?
  formData   Json                @default("{}") @map("form_data")
  externalId String              @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@index([businessId])
  @@map("ad_leads")
}

/// Accounting Sync (UPD-BE-072) — maps a local product category (NULL = catch-all default) to a
/// real external account/tax code so a pushed invoice line always resolves to something the
/// provider accepts, rather than guessing.
model AccountingMapping {
  id                  String              @id @default(uuid())
  businessId          String              @map("business_id")
  business            Business            @relation(fields: [businessId], references: [id])
  provider            IntegrationProvider
  productCategory     String?             @map("product_category")
  externalAccountCode String              @map("external_account_code")
  externalTaxCode     String?             @map("external_tax_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, provider, productCategory])
  @@map("accounting_mappings")
}

/// Automation Platforms (UPD-BE-074) — a real REST-Hook-style subscription: the automation
/// platform (Zapier/Make/n8n) registers `targetUrl` against one real `WorkflowTriggerKey` — the
/// same refined trigger taxonomy the Automations engine (UPD-BE-028) already dispatches on, via
/// the same `mapActivityEventToTriggerKey()` call site. `secret` HMAC-signs every delivery so the
/// receiving platform can verify it really came from Noxtill.
model OutboundWebhook {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  business   Business            @relation(fields: [businessId], references: [id])
  provider   IntegrationProvider
  triggerKey WorkflowTriggerKey  @map("trigger_key")
  targetUrl  String              @map("target_url") @db.Text
  secret     String
  active     Boolean             @default(true)

  deliveries OutboundWebhookDelivery[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, provider])
  @@index([businessId, triggerKey, active])
  @@map("outbound_webhooks")
}

/// One real delivery attempt log row per dispatched event (UPD-BE-074) — `attempts`/`status` are
/// updated by the BullMQ processor on every try, giving real retry/backoff visibility rather than
/// a fire-and-forget POST with no record of what happened.
model OutboundWebhookDelivery {
  id             String          @id @default(uuid())
  webhookId      String          @map("webhook_id")
  webhook        OutboundWebhook @relation(fields: [webhookId], references: [id])
  payload        Json
  status         String          @default("pending")
  attempts       Int             @default(0)
  lastAttemptAt  DateTime?       @map("last_attempt_at")
  responseStatus Int?            @map("response_status")
  error          String?         @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([webhookId, createdAt])
  @@map("outbound_webhook_deliveries")
}

model EmailCampaign {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  business     Business  @relation(fields: [businessId], references: [id])
  subject      String
  body         String    @db.Text
  segment      String
  scheduledFor DateTime? @map("scheduled_for")
  sentCount    Int       @default(0) @map("sent_count")

  events EmailEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("email_campaigns")
}

model EmailEvent {
  id              String         @id @default(uuid())
  emailCampaignId String         @map("email_campaign_id")
  emailCampaign   EmailCampaign  @relation(fields: [emailCampaignId], references: [id])
  recipient       String
  type            EmailEventType

  createdAt DateTime @default(now()) @map("created_at")

  @@index([emailCampaignId])
  @@map("email_events")
}

model ProductFeedItem {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  syncState  String   @default("pending") @map("sync_state")
  issues     Json     @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, productId])
  @@map("product_feed_items")
}

model GmbPost {
  id           String        @id @default(uuid())
  businessId   String        @map("business_id")
  business     Business      @relation(fields: [businessId], references: [id])
  text         String        @db.Text
  photoUrl     String?       @map("photo_url")
  buttonType   String?       @map("button_type")
  scheduledFor DateTime?     @map("scheduled_for")
  externalId   String?       @map("external_id")
  /// UPD-BE-042: draft until `publish()` pushes it to the real GMB Local Posts API; `failed` when
  /// that push errors (e.g. no connected/real Google credentials in this environment).
  status       GmbPostStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("gmb_posts")
}

/// Master Business Record (UPD-BE-041) — the single canonical NAP (name/address/phone) + profile
/// record `POST /listings/sync` pushes out to every connected directory-type integration (gmb,
/// bing_places, apple_business_connect, yelp). One row per business, created on first `PATCH`.
model MasterListing {
  id           String   @id @default(uuid())
  businessId   String   @unique @map("business_id")
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  phone        String?
  website      String?
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  state        String?
  postalCode   String?  @map("postal_code")
  country      String?
  /// Free-form category tags, e.g. `["Restaurant", "Pizza"]`.
  categories   Json     @default("[]")
  description  String?  @db.Text
  /// Same shape as `Business.workingHours` — kept separate since the listing's published hours
  /// can legitimately differ from the operational hours used for booking/POS logic.
  hours        Json     @default("{}")
  logoUrl      String?  @map("logo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("master_listings")
}

/// UPD-BE-044: one row per real push attempt to a directory provider (`POST /listings/sync`),
/// surfaced via `GET /listings/sync-log`.
model ListingSyncLog {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  business   Business            @relation(fields: [businessId], references: [id])
  provider   IntegrationProvider
  status     String
  message    String?             @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, provider, createdAt])
  @@map("listing_sync_logs")
}

/// UPD-BE-044 Citation Audit — a snapshot of `MasterListing`'s fields at the moment they were last
/// successfully pushed to `provider`. Auditing (`GET /seo/citations`) compares this snapshot
/// against the *current* `MasterListing` to flag "this directory is stale relative to our own
/// records" — a deliberate scope decision, not a live pull of the directory's real current data
/// (none of the 4 directory providers have a real sandbox credential in this environment).
model Citation {
  id         String              @id @default(uuid())
  businessId String              @map("business_id")
  business   Business            @relation(fields: [businessId], references: [id])
  provider   IntegrationProvider
  snapshot   Json
  syncedAt   DateTime            @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, provider])
  @@map("citations")
}

/// UPD-BE-042 GMB photo gallery entry. `url` is assumed already-uploaded (existing generic upload
/// endpoints elsewhere in the app follow this same "client already has a URL" convention) — this
/// ticket doesn't add a new S3 upload path, a disclosed scope boundary.
model GmbPhoto {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  url        String
  category   String?
  externalId String?  @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@map("gmb_photos")
}

/// UPD-BE-042 GMB Q&A. Questions arrive FROM real Google users — `syncQuestions()` pulls them via
/// a real GMB Q&A API call (requires a connected `gmb` integration with a real location selected);
/// rows aren't created directly by a business.
model GmbQna {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  business   Business  @relation(fields: [businessId], references: [id])
  question   String
  answer     String?
  externalId String?   @unique @map("external_id")
  answeredAt DateTime? @map("answered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("gmb_qnas")
}

/// UPD-BE-042 GMB Performance-API daily metrics snapshot — one row per business per day, written
/// by the nightly `GmbInsightsProcessor` (and the on-demand `POST /listings/gmb/insights/pull`).
model GmbInsightsSnapshot {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id])
  date              DateTime @db.Date
  views             Int      @default(0)
  searches          Int      @default(0)
  calls             Int      @default(0)
  directionRequests Int      @default(0) @map("direction_requests")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, date])
  @@map("gmb_insights_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────
// UPD-BE-M15 — Social Media Management
// ─────────────────────────────────────────────────────────────────────────

/// UPD-BE-045 Connected Accounts. Parallel to `Integration` (which is scoped to ads/directory
/// providers) rather than reusing it — social accounts have their own domain (posting/inbox/
/// analytics) even though the OAuth mechanics are similar.
model SocialAccount {
  id                  String              @id @default(uuid())
  businessId          String              @map("business_id")
  business            Business            @relation(fields: [businessId], references: [id])
  platform            SocialPlatform
  status              SocialAccountStatus @default(not_connected)
  /// `@db.Text` — same real overflow risk and fix as `Integration.tokens` (UPD-BE-072 bug fix).
  tokens              String?             @db.Text
  meta                Json                @default("{}")
  externalAccountId   String?             @map("external_account_id")
  externalAccountName String?             @map("external_account_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, platform])
  @@map("social_accounts")
}

/// UPD-BE-047 Media Library. `key` is an S3 object key (never a raw URL — resolved to a 24h
/// signed URL lazily on read, same convention as every other S3-backed model).
model MediaAsset {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  key        String
  type       String
  source     String
  prompt     String?
  tags       Json     @default("[]")
  usageCount Int      @default(0) @map("usage_count")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@map("media_assets")
}

/// UPD-BE-046 Content Calendar + Create Post. `mediaKeys` snapshots the S3 keys used at publish
/// time (not a live FK to MediaAsset — a post's media shouldn't change retroactively if the
/// library asset is later edited/deleted).
model SocialPost {
  id              String           @id @default(uuid())
  businessId      String           @map("business_id")
  business        Business         @relation(fields: [businessId], references: [id])
  caption         String           @db.Text
  mediaKeys       Json             @default("[]")
  scheduledFor    DateTime?        @map("scheduled_for")
  status          SocialPostStatus @default(draft)
  createdByUserId String?          @map("created_by_user_id")

  targets SocialPostTarget[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("social_posts")
}

/// One row per platform a `SocialPost` targets — the real per-target publish outcome (some
/// platforms can succeed while others fail on the same post). Excluded from `TENANT_SCOPED_MODELS`
/// — scoped transitively via `SocialPost`, same precedent as `StockCountLine`/`ReturnItem`.
model SocialPostTarget {
  id           String                 @id @default(uuid())
  socialPostId String                 @map("social_post_id")
  socialPost   SocialPost             @relation(fields: [socialPostId], references: [id])
  platform     SocialPlatform
  status       SocialPostTargetStatus @default(pending)
  externalId   String?                @map("external_id")
  errorMessage String?                @map("error_message")
  publishedAt  DateTime?              @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([socialPostId, platform])
  @@map("social_post_targets")
}

/// UPD-BE-049 Social Inbox. `externalId` is the platform's own comment/DM id — the
/// `(businessId, platform, externalId)` unique constraint is what makes webhook ingestion
/// idempotent at the row level, on top of the shared `WebhookEvent` gate.
model SocialInboxItem {
  id             String            @id @default(uuid())
  businessId     String            @map("business_id")
  business       Business          @relation(fields: [businessId], references: [id])
  platform       SocialPlatform
  externalId     String            @map("external_id")
  kind           SocialInboxKind
  authorName     String?           @map("author_name")
  text           String            @db.Text
  postExternalId String?           @map("post_external_id")
  status         SocialInboxStatus @default(unread)
  repliedText    String?           @map("replied_text") @db.Text
  repliedAt      DateTime?         @map("replied_at")
  receivedAt     DateTime          @map("received_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, platform, externalId])
  @@index([businessId, status])
  @@map("social_inbox_items")
}

/// UPD-BE-050 Social Analytics — one row per business per platform per day, written by the
/// nightly insights-pull job (same shape as `GmbInsightsSnapshot`).
model SocialAnalyticsSnapshot {
  id          String         @id @default(uuid())
  businessId  String         @map("business_id")
  business    Business       @relation(fields: [businessId], references: [id])
  platform    SocialPlatform
  date        DateTime       @db.Date
  followers   Int            @default(0)
  reach       Int            @default(0)
  engagement  Int            @default(0)
  impressions Int            @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([businessId, platform, date])
  @@map("social_analytics_snapshots")
}

/// UPD-BE-051 Social Settings — one row per business (upsert-on-write, same pattern as
/// `MasterListing`).
model SocialSettings {
  id            String   @id @default(uuid())
  businessId    String   @unique @map("business_id")
  business      Business @relation(fields: [businessId], references: [id])
  autoPostRules Json     @default("{}") @map("auto_post_rules")
  hashtagSets   Json     @default("{}") @map("hashtag_sets")
  brandVoice    String?  @map("brand_voice")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_settings")
}

// ─────────────────────────────────────────────────────────────────────────
// BE-M11 — Widgets, Dashboard, Search, Analytics
// ─────────────────────────────────────────────────────────────────────────

/// Product-analytics instrumentation (BE-072). Not tenant-scoped by the
/// Prisma extension — recorded explicitly per request and read cross-tenant
/// by platform-admin endpoints, so businessId is nullable (pre-signup events)
/// and every access goes through the raw PrismaService on purpose.
model Event {
  id         String   @id @default(uuid())
  businessId String?  @map("business_id")
  userId     String?  @map("user_id")
  name       String
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@index([businessId])
  @@map("events")
}

// ─────────────────────────────────────────────────────────────────────────
// BE-M12 — AI Assistant
// ─────────────────────────────────────────────────────────────────────────

/// Shared AI infra call log (BE-075) — every AI feature in the product logs
/// through here. Not tenant-scoped: businessId is nullable (BusinessTypesService's
/// AI-map runs pre-signup, before a business exists) and rate-limit/cost-cap
/// checks read across this table directly via the raw PrismaService.
model AiCallLog {
  id               String   @id @default(uuid())
  businessId       String?  @map("business_id")
  kind             String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(10, 4)
  /// Which tools were invoked and what they returned — the audit trail behind "never fabricated" (BE-074).
  toolCalls        Json?    @map("tool_calls")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("ai_call_logs")
}

/// RAG help-pipeline source content (BE-073) — small enough that a keyword/
/// trigram hybrid over this table is plenty; no separate vector store needed.
model HelpArticle {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  body      String   @db.Text
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Two separate single-column indexes (not one composite) so `help.service.ts` can score
  /// `MATCH(title)`/`MATCH(body)` independently and weight title matches higher.
  @@fulltext([title])
  @@fulltext([body])
  @@map("help_articles")
}
