generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  owner
  manager
  staff
}

enum ProductKind {
  product
  service
}

enum OrderType {
  counter
  online
  dine_in
  takeaway
  delivery
  quotation
}

enum OrderStatus {
  draft
  pending
  confirmed
  in_progress
  completed
  cancelled
}

enum PaymentMethod {
  cash
  card
  online
  credit
}

enum CreditEntryKind {
  credit
  payment
  /// Write-off flow (UPD-BE-023) — reduces balance like `payment` (see `v_credit_balances`'s
  /// `CASE WHEN kind = 'credit' THEN +amount ELSE -amount END`), but is a distinct, filterable
  /// kind so a written-off debt is never confused with a real cash/card/online payment received.
  write_off
}

enum InstallmentPlanStatus {
  active
  completed
  cancelled
}

enum InstallmentStatus {
  pending
  paid
  cancelled
}

/// Credit reminder rules (UPD-BE-095) — the escalation tone a staged rule sends at.
enum CreditReminderTone {
  gentle
  firm
  final
}

enum ActivityEventType {
  sale
  booking
  review
  payment
  complaint
  stock
  low_stock
  customer_lapsed
  credit_overdue
  birthday
}

enum CouponType {
  percentage
  fixed
}

enum VoucherStatus {
  active
  redeemed
  cancelled
}

/// Automations engine (UPD-BE-028) trigger keys — each maps from a real `ActivityEvent` write
/// (see `ActivityService.record()` -> `WorkflowTriggerService.dispatch()`), never a placeholder.
enum WorkflowTriggerKey {
  sale
  booking_completed
  lapsed_customer
  low_stock
  review
  credit_overdue
  birthday
}

enum WorkflowRunStatus {
  success
  failed
  skipped
}

enum CashShiftStatus {
