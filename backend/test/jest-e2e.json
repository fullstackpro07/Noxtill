{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^puppeteer$": "<rootDir>/test/__mocks__/puppeteer.js",
    "^archiver$": "<rootDir>/test/__mocks__/archiver.js"
  },
  "forceExit": true
}
